---
import OtherWorksGallery from "./OtherWorksGallery.astro";
---
<section class="other-works section" id="other-works">
  <div class="site-shell">
    <div class="section-heading">
      <div><p class="section-kicker">(C) CREATIVE EXPLORATIONS</p><h2>Other <em>works.</em></h2></div>
      <p class="other-works__intro">An exploration of graphic design, visual storytelling, and creative projects beyond digital products.</p>
    </div>
    <OtherWorksGallery preview />
    <a href="/other-works/" class="text-link other-works__link">EXPLORE GRAPHIC DESIGN →</a>
  </div>
</section>
<style>
  .other-works__intro { max-width: 32rem; color: var(--text-muted); line-height: 1.7; }
  .other-works__link { display: inline-block; margin-top: 2.5rem; }
</style>
