---
const newsletterSequence = [
  { kind: "cover", pages: [{ file: 1, number: 1 }] },
  { kind: "spread", pages: [{ file: 2, number: 2 }, { file: 3, number: 3 }] },
  { kind: "spread", pages: [{ file: 4, number: 4 }, { file: 5, number: 5 }] },
  { kind: "closing", pages: [{ file: 7, number: 6 }] }
];
const campaigns = [
  {file:"metaverse.jpg",title:"Metaverse"},
  {file:"WEB 3.0.jpg",title:"Web 3.0"},
  {file:"GEMMA.jpg",title:"Woman Crush"},
  {file:"kano.jpg",title:"Throwback"},
  {file:"hvd.jpg",title:"Love Letter Geng — Even hotheaded lawyers fall in love"},
  {file:"hnmm.jpg",title:"Happy New Month — February, the season of love"}
];
---
<div class="concierge-galleries">
  <section aria-labelledby="scribbles-heading">
    <h3 id="scribbles-heading">Editorial Design: Scribbles Newsletter</h3>
    <p>February 2022 · Six-page newsletter</p>
    <div class="newsletter-gallery">
      {newsletterSequence.map(group => <div class:list={["newsletter-group", `newsletter-group--${group.kind}`]}>
        {group.pages.map(page => <button class="artwork-open" aria-label={`Enlarge Scribbles Newsletter page ${page.number}`}><img src={`/images/other-works/Artboard ${page.file}.png`} alt={`Scribbles Newsletter, February 2022, page ${page.number}`} width="1240" height="1754" loading="lazy" /></button>)}
      </div>)}
    </div>
  </section>
  <section aria-labelledby="creed-heading">
    <h3 id="creed-heading">Social Media Series: The Optimist Creed</h3>
    <p>Representative design from a six-part series.</p>
    <button class="artwork-open creed" aria-label="Enlarge The Optimist Creed"><img src="/images/other-works/creed1.jpg" alt="The Optimist Creed — Promise yourself" width="2000" height="2000" loading="lazy" /></button>
  </section>
  <section aria-labelledby="concierge-campaign-heading">
    <h3 id="concierge-campaign-heading">Other Social Media &amp; Campaign Designs</h3>
    <div class="campaign-gallery">
      {campaigns.map(artwork => <button class="artwork-open" aria-label={`Enlarge ${artwork.title}`}><img src={`/images/other-works/${artwork.file}`} alt={artwork.title} width="2000" height="2000" loading="lazy" /></button>)}
    </div>
  </section>
</div>
<style>
.concierge-galleries { display:grid; gap:2.5rem; min-width:0; }
h3 { font-family:var(--font-display); font-size:clamp(1.3rem,2vw,1.7rem); margin:0 0 1rem; }
p { color:var(--text-muted); margin:0 0 1rem; }
.newsletter-gallery {
  display:grid;
  grid-template-columns:minmax(0,1.7fr) minmax(0,1fr) minmax(0,.48fr);
  gap:1rem;
  align-items:center;
  padding-block:.5rem;
}
.newsletter-group { min-width:0; }
.newsletter-group--cover { grid-column:1; grid-row:1 / 3; width:100%; }
.newsletter-group--spread { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.5rem; align-items:start; grid-column:2; }
.newsletter-group--spread:nth-child(2) { grid-row:1; align-self:end; }
.newsletter-group--spread:nth-child(3) { grid-row:2; align-self:start; }
.newsletter-group--closing { grid-column:3; grid-row:1 / 3; width:100%; }
.artwork-open { display:block; padding:0; border:0; background:none; cursor:zoom-in; width:100%; min-width:0; }
img { display:block; width:100%; height:auto; }
.creed { width:min(100%,25rem); }
.campaign-gallery {
  --campaign-gap:.75rem;
  --campaign-height:calc((100% - var(--campaign-gap) * 5 / 6) * 6 / 11);
  display:grid;
  grid-template-columns:minmax(0,calc((var(--campaign-height) - var(--campaign-gap)) / 2)) minmax(0,var(--campaign-height)) minmax(0,1fr);
  grid-template-rows:repeat(6,minmax(0,1fr));
  gap:var(--campaign-gap);
  align-items:start;
}
.campaign-gallery .artwork-open:nth-child(1) { grid-column:1; grid-row:1 / 4; }
.campaign-gallery .artwork-open:nth-child(2) { grid-column:1; grid-row:4 / 7; }
.campaign-gallery .artwork-open:nth-child(3) { grid-column:3; grid-row:1 / 3; }
.campaign-gallery .artwork-open:nth-child(4) { grid-column:3; grid-row:3 / 5; }
.campaign-gallery .artwork-open:nth-child(5) { grid-column:2; grid-row:1 / 7; }
.campaign-gallery .artwork-open:nth-child(6) { grid-column:3; grid-row:5 / 7; }
@media(max-width:600px) {
  .campaign-gallery { grid-template-columns:repeat(2,minmax(0,1fr)); grid-template-rows:none; gap:.75rem; }
  .campaign-gallery .artwork-open:nth-child(n) { grid-column:auto; grid-row:auto; width:100%; align-self:start; }
  .campaign-gallery .artwork-open:nth-child(5) { grid-column:1 / -1; grid-row:1; }
  .newsletter-gallery { grid-template-columns:1fr; gap:1.25rem; }
  .newsletter-gallery .newsletter-group { grid-column:1; grid-row:auto; width:100%; }
  .newsletter-group--cover, .newsletter-group--closing { width:100%; }
  .newsletter-group--spread { grid-template-columns:1fr; gap:2rem; }
}
</style>
