---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
const { project } = Astro.props;
let imageSrc = project.image;
if (project.slug === "pawsitive-futures") {
  const candidates = [project.image, "/images/projects/pawsitive-futures/hero.jpg"];
  imageSrc = candidates.find(src => src && existsSync(resolve("public", src.slice(1))));
}
const hasImage = Boolean(imageSrc);
---
{hasImage ? (
  <img src={imageSrc} alt={`${project.title} project preview`} />
) : (
  <div class="project-preview-text">
    <span>{project.category}</span>
    <strong>{project.title}</strong>
    <span>Responsive animal rescue website</span>
  </div>
)}
<style>
  .project-preview-text { display: flex; flex-direction: column; justify-content: center; gap: 1.25rem; min-height: 24rem; padding: clamp(2rem, 5vw, 4rem); background: var(--bg-soft); color: var(--text); }
  .project-preview-text strong { font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 500; line-height: 1.1; }
  .project-preview-text span { font-size: 0.85rem; }
</style>