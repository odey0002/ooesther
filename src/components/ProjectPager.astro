---
import { getProjectNavigation } from "../data/projects.js";

const { currentSlug } = Astro.props;
const { previousProject, nextProject } = getProjectNavigation(currentSlug);
---

<nav class="project-pager" aria-label="Project navigation">
  {previousProject && (
    <a href={previousProject.link} class="project-pager__link project-pager__link--previous">
      <span>← Previous Project</span>
      <strong>{previousProject.title}</strong>
    </a>
  )}

  <a href="/#work" class="project-pager__center">
    All Work
  </a>

  {nextProject && (
    <a href={nextProject.link} class="project-pager__link project-pager__link--next">
      <span>Next Project →</span>
      <strong>{nextProject.title}</strong>
    </a>
  )}
</nav>

<style>
  .project-pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    align-items: stretch;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .project-pager__link,
  .project-pager__center {
    border: 1px solid var(--border);
    padding: 1.25rem;
    color: var(--text);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .project-pager__link:hover,
  .project-pager__center:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    background: var(--bg-soft);
  }

  .project-pager__link span {
    display: block;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .project-pager__link strong {
    display: block;
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .project-pager__link--next {
    text-align: right;
  }

  .project-pager__center {
    display: inline-grid;
    min-width: 8rem;
    place-items: center;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .project-pager {
      grid-template-columns: 1fr;
    }

    .project-pager__link--next {
      text-align: left;
    }

    .project-pager__center {
      min-width: 100%;
    }
  }
</style>