  <dialog class="artwork-dialog" aria-label="Artwork viewer">
    <div class="viewer-tools">
      <button data-action="previous" aria-label="Previous image">←</button>
      <span class="viewer-count" aria-live="polite"></span>
      <button data-action="next" aria-label="Next image">→</button>
      <button data-action="out" aria-label="Zoom out">−</button>
      <button data-action="reset" aria-label="Reset zoom">100%</button>
      <button data-action="in" aria-label="Zoom in">+</button>
      <button data-action="close" aria-label="Close image viewer">✕</button>
    </div>
    <div class="viewer-stage"><img class="viewer-image" alt="" /></div>
  </dialog>
<style>
.artwork-dialog { width:100vw; max-width:100vw; height:100dvh; max-height:100dvh; padding:0; border:0; background:rgba(20,18,16,.94); color:white; }
.artwork-dialog::backdrop { background:rgba(0,0,0,.8); }
.viewer-tools { display:flex; align-items:center; justify-content:center; gap:.75rem; padding:1rem; min-height:5rem; }
.viewer-tools button { background:#302c27; color:white; border:1px solid #777; min-width:44px; min-height:44px; cursor:pointer; }
.viewer-tools button:disabled { opacity:.35; cursor:default; }
.viewer-stage { height:calc(100% - 5rem); overflow:auto; padding:1.5rem; display:grid; place-items:safe center; }
.viewer-image[src*="Icon1-03-03-03.png"] { background:white; }
.viewer-image { display:block; max-width:none; height:auto; cursor:zoom-in; }

@media(max-width:760px) { .viewer-tools { gap:.3rem; padding:.5rem; } }
</style>
<script>
const dialog = document.querySelector<HTMLDialogElement>(".artwork-dialog")!;
const stage = dialog.querySelector<HTMLElement>(".viewer-stage")!;
const enlarged = dialog.querySelector<HTMLImageElement>(".viewer-image")!;
const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>(".artwork-open"));
const count = dialog.querySelector<HTMLElement>(".viewer-count")!;
const reset = dialog.querySelector<HTMLButtonElement>('[data-action="reset"]')!;
let index = 0, zoom = 1;
let opener: HTMLButtonElement | null = null;
let previousOverflow = "";
function sizeImage() {
  const source = triggers[index].querySelector("img")!;
  const ratio = Number(source.width) / Number(source.height);
  const base = Math.min(stage.clientWidth - 48, (stage.clientHeight - 48) * ratio);
  enlarged.style.width = `${Math.max(1, base) * zoom}px`;
  reset.textContent = `${Math.round(zoom * 100)}%`;
}
function showImage() {
  const source = triggers[index].querySelector("img")!;
  enlarged.src = source.src; enlarged.alt = source.alt;
  zoom = 1; sizeImage(); stage.scrollTop = 0; stage.scrollLeft = 0;
  count.textContent = `${index + 1} / ${triggers.length}`;
  for (const action of ["previous", "next"]) dialog.querySelector<HTMLButtonElement>(`[data-action="${action}"]`)!.disabled = triggers.length < 2;
}
function setZoom(value: number) { zoom = Math.min(4, Math.max(1, value)); sizeImage(); }
triggers.forEach((button, i) => button.addEventListener("click", () => {
  index = i; opener = button; previousOverflow = document.body.style.overflow;
  dialog.showModal(); document.body.style.overflow = "hidden"; showImage();
}));
dialog.addEventListener("click", event => {
  const target = event.target as HTMLElement;
  const action = target.closest<HTMLButtonElement>("[data-action]")?.dataset.action;
  if (action === "close" || target === stage || target === dialog) dialog.close();
  else if (action === "in") setZoom(zoom + .5);
  else if (action === "out") setZoom(zoom - .5);
  else if (action === "reset") setZoom(1);
  else if (action === "previous" || action === "next") { index = (index + (action === "next" ? 1 : -1) + triggers.length) % triggers.length; showImage(); }
  else if (target === enlarged) setZoom(zoom === 1 ? 2 : 1);
});
dialog.addEventListener("keydown", event => {
  if (event.key === "ArrowLeft" || event.key === "ArrowRight") { event.preventDefault(); index = (index + (event.key === "ArrowRight" ? 1 : -1) + triggers.length) % triggers.length; showImage(); }
});
dialog.addEventListener("close", () => { document.body.style.overflow = previousOverflow; opener?.focus(); });
window.addEventListener("resize", () => { if (dialog.open) sizeImage(); });
</script>
