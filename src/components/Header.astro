---
const currentPath = Astro.url.pathname;

const isUiUxActive = currentPath.startsWith("/ui-ux");
const isGraphicsActive = currentPath.startsWith("/graphics");
const isAboutActive = currentPath.startsWith("/about");
---

<header class="site-header" data-site-header>
  <a href="/" class="site-logo" aria-label="Go to homepage">
    <img
      class="site-logo__img site-logo__img--dark"
      src="/images/site/logo-dark.png"
      alt="Esther Odeyemi logo"
    />

    <img
      class="site-logo__img site-logo__img--light"
      src="/images/site/logo-light.png"
      alt=""
      aria-hidden="true"
    />
  </a>

  <nav class="site-nav" id="site-navigation" aria-label="Main navigation">
    <a class:list={[{ "is-active": isUiUxActive }]} href="/ui-ux">
      UI/UX
    </a>

    <a class:list={[{ "is-active": isGraphicsActive }]} href="/graphics">
      Graphics
    </a>

    <a class:list={[{ "is-active": isAboutActive }]} href="/about">
      About
    </a>

    <a href="/#contact">
      Contact
    </a>
  </nav>

  <div class="site-header__actions">
    <button
      class="theme-toggle"
      data-theme-toggle
      type="button"
      aria-label="Switch theme"
    >
      🌙
    </button>

    <button
      class="mobile-nav-toggle"
      data-mobile-nav-toggle
      type="button"
      aria-label="Open navigation menu"
      aria-controls="site-navigation"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script is:inline>
  const header = document.querySelector("[data-site-header]");
  const menuButton = document.querySelector("[data-mobile-nav-toggle]");
  const nav = document.querySelector("#site-navigation");

  if (header && menuButton && nav) {
    const closeMenu = () => {
      header.classList.remove("is-menu-open");
      document.body.classList.remove("is-menu-open");
      menuButton.setAttribute("aria-expanded", "false");
      menuButton.setAttribute("aria-label", "Open navigation menu");
    };

    const openMenu = () => {
      header.classList.add("is-menu-open");
      document.body.classList.add("is-menu-open");
      menuButton.setAttribute("aria-expanded", "true");
      menuButton.setAttribute("aria-label", "Close navigation menu");
    };

    menuButton.addEventListener("click", () => {
      const isOpen = header.classList.contains("is-menu-open");

      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 1100) {
        closeMenu();
      }
    });
  }
</script>