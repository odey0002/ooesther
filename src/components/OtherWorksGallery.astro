---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { otherWorks } from "../data/otherWorks.js";
const { preview = false } = Astro.props;
const works = preview ? otherWorks.filter(work => work.featured) : otherWorks;
const groups = preview
  ? [["midnight-masterpiece"], ["carson-furniture", "mystery-fountain"], ["chocolate-launch"]]
      .map(slugs => slugs.map(slug => works.find(work => work.slug === slug)).filter(Boolean))
  : [works];
---
<div class:list={["other-gallery", { "other-gallery--wall": preview }]}>
  {groups.map(group => (
    <div class="other-gallery__group">
    {group.map(work => (
    <article id={preview ? undefined : work.slug} style={`--work-order: ${works.indexOf(work)}`}>
      {existsSync(resolve("public", work.image.slice(1))) ? (
        <a class="other-gallery__image" href={preview ? `/other-works/#${work.slug}` : work.image} aria-label={preview ? `View ${work.title}` : `Enlarge ${work.title}`}>
          <img src={work.image} alt={work.alt || `${work.title}: ${work.category}`} width={work.width} height={work.height} loading="lazy" decoding="async" />
        </a>
      ) : (
        <div class="other-gallery__pending"><span>Artwork coming soon</span></div>
      )}
      <div class="other-gallery__caption">
        <h3>{work.title}</h3>
        <p>{work.category}</p>
      </div>
    </article>
    ))}
    </div>
  ))}
</div>
<style>
  .other-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem 2rem; }
  article { min-width: 0; scroll-margin-top: 7rem; }
  .other-gallery__image, .other-gallery__pending { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--bg-soft); border: 1px solid var(--border); }
  .other-gallery__image img { width: 100%; height: 100%; object-fit: contain; }
  .other-gallery__image:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .other-gallery__pending { color: var(--text-muted); font-size: .85rem; }
  h3 { font-family: var(--font-display); font-size: clamp(1.4rem, 2.5vw, 2rem); margin: 1rem 0 .35rem; }
  p { color: var(--text-muted); font-size: .9rem; }
  @media (max-width: 640px) { .other-gallery { grid-template-columns: 1fr; gap: 2rem; } }

  .other-gallery__group { display: contents; }
  .other-gallery__caption { min-width: 0; }
  .other-gallery--wall {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 24px;
    align-items: start;
    max-width: 59.5rem;
    margin-inline: auto;
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  .other-gallery--wall .other-gallery__group { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .other-gallery--wall .other-gallery__group:nth-child(1),
  .other-gallery--wall .other-gallery__group:nth-child(3) { padding-top: 1.5rem; }
  .other-gallery--wall article { width: 100%; }
  .other-gallery--wall .other-gallery__image {
    display: block;
    aspect-ratio: auto;
    background: none;
    border: 0;
    transition: transform 260ms ease;
    transform-origin: center;
  }
  .other-gallery--wall .other-gallery__image img { display: block; width: 100%; height: auto; }
  .other-gallery--wall h3 { font-size: clamp(1.15rem, 1.7vw, 1.4rem); line-height: 1.25; margin: .85rem 0 .3rem; transition: color 240ms ease; }
  .other-gallery--wall p { font-size: .8rem; line-height: 1.5; margin: 0; }
  .other-gallery--wall article:focus-within h3 { color: var(--accent); }
  .other-gallery--wall .other-gallery__image:focus-visible { transform: translateY(-8px) scale(1.025); }
  @media (hover: hover) {
    .other-gallery--wall article:hover .other-gallery__image { transform: translateY(-8px) scale(1.025); }
    .other-gallery--wall article:hover h3 { color: var(--accent); }
  }
  @media (max-width: 900px) {
    .other-gallery--wall { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 2rem; max-width: 42rem; }
    .other-gallery--wall .other-gallery__group { display: contents; }
    .other-gallery--wall .other-gallery__group article { order: var(--work-order); width: 100%; }
  }
  @media (max-width: 640px) {
    .other-gallery--wall { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .other-gallery--wall .other-gallery__group article { width: min(80%, 17rem); justify-self: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .other-gallery--wall .other-gallery__image, .other-gallery--wall h3 { transition: none; }
    .other-gallery--wall article:hover .other-gallery__image,
    .other-gallery--wall .other-gallery__image:focus-visible { transform: none; }
  }
</style>
