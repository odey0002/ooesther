---
const groups = [
  { title: "TSMART Fashion", className: "fashion", artworks: [
    {file:"image10.jpeg",title:"Tife editorial",width:1024,height:1024},
    {file:"TSMARTtt.jpg",title:"Tiwa editorial",width:2480,height:3508},
    {file:"image15.jpeg",title:"Power Woman promotional design",width:1080,height:1080},
    {file:"image0.jpeg",title:"Merry Christmas promotional design",width:1280,height:1280}
  ]},
  { title: "TSMART Fashion Academy", className: "academy", artworks: [
    {file:"image2 (1).jpeg",title:"Scholarship Program",width:749,height:668},
    {file:"image6.png",title:"Instagram Live Session",width:3000,height:3000}
  ]},
  { title: "MyWarehouse.ng", className: "warehouse", artworks: [
    {file:"image7.png",title:"New Year Offer",width:3000,height:3000},
    {file:"image4.jpeg",title:"RELAX campaign",width:750,height:744},
    {file:"image1.jpeg",title:"Small Business Owner Instagram Live",width:1080,height:1080}
  ]}
];
---
<div class="tsmart-galleries">
  {groups.map(group => <section aria-label={group.title}>
    <h3>{group.title}</h3>
    <div class:list={["brand-gallery", group.className]}>
      {group.artworks.map(artwork => <button class="artwork-open" aria-label={`Enlarge ${artwork.title}`}>
        <img src={`/images/other-works/${artwork.file}`} alt={artwork.title} width={artwork.width} height={artwork.height} loading="lazy" />
      </button>)}
    </div>
  </section>)}
</div>
<style>
.tsmart-galleries { display:grid; gap:2rem; min-width:0; }
h3 { font-family:var(--font-display); font-size:clamp(1.3rem,2vw,1.7rem); margin:0 0 1rem; }
.brand-gallery { display:grid; gap:.75rem; align-items:center; }
.artwork-open { display:block; padding:0; border:0; background:none; cursor:zoom-in; width:100%; min-width:0; }
img { display:block; width:100%; height:auto; }
.fashion { grid-template-columns:minmax(0,.72fr) minmax(0,1.5fr) minmax(0,1.05fr); align-items:center; }
.fashion .artwork-open:first-child { grid-column:2; grid-row:1 / 3; }
.fashion .artwork-open:nth-child(2) { grid-column:3; grid-row:1 / 3; }
.fashion .artwork-open:nth-child(3) { grid-column:1; grid-row:1; }
.fashion .artwork-open:nth-child(4) { grid-column:1; grid-row:2; }
.academy { grid-template-columns:minmax(0,749fr) minmax(0,668fr); align-items:start; }
.warehouse { grid-template-columns:minmax(0,calc((100% - 2 * .75rem) * 1.992 / 2.992 + .75rem)) minmax(0,1fr); align-items:start; }
.warehouse .artwork-open:first-child { grid-column:1; grid-row:1 / 3; }
.warehouse .artwork-open:nth-child(2) { grid-column:2; grid-row:1; }
.warehouse .artwork-open:nth-child(3) { grid-column:2; grid-row:2; }
@media(max-width:600px) {
 .fashion { grid-template-columns:repeat(2,minmax(0,1fr)); }
 .fashion .artwork-open:first-child { grid-column:1 / -1; grid-row:1; }
 .fashion .artwork-open:nth-child(2) { grid-column:1; grid-row:2 / 4; }
 .fashion .artwork-open:nth-child(3) { grid-column:2; grid-row:2; }
 .fashion .artwork-open:nth-child(4) { grid-column:2; grid-row:3; }

 .warehouse { grid-template-columns:repeat(2,minmax(0,1fr)); }
 .warehouse .artwork-open:first-child { grid-column:1 / -1; grid-row:1; }
 .warehouse .artwork-open:nth-child(2) { grid-column:1; grid-row:2; }
 .warehouse .artwork-open:nth-child(3) { grid-column:2; grid-row:2; }
}
</style>
