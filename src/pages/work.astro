---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getWorkProjects } from "../data/projects.js";

const workProjects = getWorkProjects();
---

<BaseLayout
  title="Work - Esther Odeyemi"
  description="A collection of product design, UI/UX, web, branding, packaging, and visual design projects by Esther Odeyemi."
>
  <Header />

  <main class="project-detail">
    <section class="archive-hero site-shell section">
      <a href="/" class="project-back-link">← Home</a>

      <p class="project-label">Product / UI / Web / Brand</p>
      <h1>Work</h1>

      <p class="project-hero__summary">
        A collection of digital product, web, branding, and visual design work
        focused on clarity, usability, strong systems, and thoughtful visual direction.
      </p>
    </section>

    <section class="work section archive-projects">
      <div class="site-shell">
        <div class="work__list">
          {
            workProjects.map((project, index) => (
              <a
                href={project.link}
                class={`project-feature ${
                  index % 2 === 1 ? "project-feature--flipped" : ""
                }`}
              >
                <figure class="project-feature__image">
                  <img
                    src={project.image}
                    alt={`${project.title} project preview`}
                  />
                </figure>

                <div class="project-feature__content">
                  <div class="project-feature__meta">
                    <span class="project-feature__number">
                      {project.number}
                    </span>

                    <span>
                      {project.category} / {project.year}
                    </span>
                  </div>

                  <h3>{project.title}</h3>

                  <p>{project.description}</p>

                  <ul class="tag-list">
                    {project.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>