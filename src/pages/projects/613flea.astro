<BaseLayout
  title="613Flea - Brand and Web Case Study"
  description="613Flea is a responsive brand and website redesign for an Ottawa indoor marketplace, focused on visual identity, vendor discovery, visitor planning, and community engagement."
>
  <Header />

  <main class="project-detail flea-page">
    <section class="project-hero site-shell section">
      <a href="/#work" class="project-back-link">← Work</a>

      <div class="project-hero__intro">
        <p class="project-number">{project?.number ?? "02"}</p>

        <div>
          <p class="project-label">Brand + Web - 2025</p>
          <h1>613Flea</h1>

          <p class="project-hero__summary">
            Building an online presence for a local flea market. 613Flea is a not-for-profit
            indoor marketplace in Ottawa known for vintage pieces, handmade goods, and local vendors.
          </p>
        </div>
      </div>

      <figure class="project-hero__image flea-hero-card">
  <img
    class="flea-hero-card__main"
    src="/images/projects/613flea/hero.png"
    alt="613Flea redesigned website hero mockup"
  />

  <figcaption class="flea-existing-site-mini-card">
    <div class="flea-existing-site-mini-card__label">
      <span>Existing Website</span>
      <small>Before redesign</small>
    </div>

    <img
      src="/images/projects/613flea/existing-website.png"
      alt="Original 613Flea website homepage before redesign"
    />

    <p>
      The original homepage had a handmade market feel, but needed clearer hierarchy,
      stronger visual structure, and a more flexible brand system.
    </p>
  </figcaption>
</figure>

      <dl class="project-facts">
        <div>
          <dt>Role</dt>
          <dd>UX + UI Design, Visual Design, Branding, Research, Prototyping + Testing</dd>
        </div>

        <div>
          <dt>Tools</dt>
          <dd>Figma, FigJam, Basecamp, Maze</dd>
        </div>

        <div>
          <dt>Timeframe</dt>
          <dd>May - Aug 2025</dd>
        </div>

        <div>
          <dt>Year</dt>
          <dd>2025</dd>
        </div>
      </dl>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label">
        <p>Project Overview</p>
      </div>

      <div class="project-section__content">
        <p class="project-lead">
          613Flea is a not-for-profit indoor marketplace in Ottawa known for vintage pieces,
          handmade goods, and local vendors. This project reimagines its brand identity and
          website to create a more current, cohesive presence across digital and print platforms.
        </p>

        <div class="detail-grid">
          {overviewPoints.map((item) => (
            <article class="detail-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>

      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label">
