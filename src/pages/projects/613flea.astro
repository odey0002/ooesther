              </div>
            </header>

            <div class="flea-iteration-card__markers">
              {iteration.markers.map((marker) => (
                <article>
                  <span>{marker.number}</span>

                  <div>
                    <h5>{marker.title}</h5>
                    <p>{marker.text}</p>
                  </div>
                </article>
              ))}
            </div>

            <div class="flea-before-after-pair">
              <figure>
                <div class={`flea-before-after-pair__image ${iteration.imageClass}`}>
                  <img src={iteration.beforeImage} alt={iteration.beforeAlt} />

                  {iteration.imageMarkers.before.map((marker) => (
                    <span
                      class="flea-screen-marker"
                      style={`--x: ${marker.x}%; --y: ${marker.y}%;`}
                      aria-label={marker.label}
                    >
                      {marker.number}
                    </span>
                  ))}
                </div>

                <figcaption>Before</figcaption>
              </figure>

              <strong aria-hidden="true">→</strong>

              <figure>
                <div class={`flea-before-after-pair__image ${iteration.imageClass}`}>
                  <img src={iteration.afterImage} alt={iteration.afterAlt} />

                  {iteration.imageMarkers.after.map((marker) => (
                    <span
                      class="flea-screen-marker"
                      style={`--x: ${marker.x}%; --y: ${marker.y}%;`}
                      aria-label={marker.label}
