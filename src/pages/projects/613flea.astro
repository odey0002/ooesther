  </dialog>

  <script>
    function setupFleaBoards() {
      const dialog = document.querySelector<HTMLDialogElement>('.flea-board-dialog');
      const imageContainer = dialog?.querySelector<HTMLDivElement>('.flea-board-dialog__image');
      if (!dialog || !imageContainer || dialog.dataset.ready) return;
      dialog.dataset.ready = 'true';
      const zoom = dialog.querySelector<HTMLButtonElement>('.flea-board-dialog__zoom');
      function setZoom(actualSize: boolean) {
        imageContainer!.classList.toggle('is-actual-size', actualSize);
        if (zoom) {
          zoom.textContent = actualSize ? 'Fit to window' : 'View actual size';
          zoom.setAttribute('aria-pressed', String(actualSize));
        }
        imageContainer!.scrollTo(0, 0);
      }
      zoom?.addEventListener('click', () => {
        setZoom(!imageContainer.classList.contains('is-actual-size'));
      });
      let opener: HTMLButtonElement | null = null;
      document.querySelectorAll<HTMLButtonElement>('.flea-board-open').forEach((button) => {
        const thumbnail = button.querySelector('img');
        if (!thumbnail) return;
        button.setAttribute('aria-label', `Enlarge: ${thumbnail.alt}`);
        button.addEventListener('click', () => {
          const enlarged = new Image();
          enlarged.src = thumbnail.currentSrc || thumbnail.src;
          enlarged.alt = thumbnail.alt;
          imageContainer.replaceChildren(enlarged);
          setZoom(false);
          opener = button;
          dialog.showModal();
          document.documentElement.classList.add('flea-board-is-open');
          imageContainer.scrollTo(0, 0);
        });
      });
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
      });
      dialog.addEventListener('close', () => {
        document.documentElement.classList.remove('flea-board-is-open');
        opener?.focus({ preventScroll: true });
      });
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.classList.remove('flea-board-is-open');
      }, { once: true });
    }
    setupFleaBoards();
    document.addEventListener('astro:page-load', setupFleaBoards);
  </script>
