  },
  {
    title: "Curated Discovery vs. Choice Overload",
    observation:
      "With 100+ vendors, shoppers can feel overwhelmed and cannot easily find specific interests before they arrive.",
    implication:
      "Implement filters so people can browse vendors and explore what interests them before visiting.",
  },
];

