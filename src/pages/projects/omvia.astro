---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectPager from "../../components/ProjectPager.astro";
import { getProjectBySlug } from "../../data/projects.js";

import "../../styles/projects/omvia.css";

const project = getProjectBySlug("omvia");

const prototypeUrl = "https://www.figma.com/proto/n1HrOSWuPKgLjaJ5UhpT6Q/smart-home-app-mine--Copy-?node-id=307-3582&p=f&viewport=1189%2C-3634%2C0.21&t=cr2ZpQNTxKqv4qNN-1&scaling=scale-down&content-scaling=fixed&starting-point-node-id=307%3A3582&page-id=0%3A1";
const prototypeEmbedSrc = "https://embed.figma.com/proto/n1HrOSWuPKgLjaJ5UhpT6Q/smart-home-app-mine--Copy-?node-id=307-3582&p=f&viewport=1189%2C-3634%2C0.21&scaling=scale-down&content-scaling=fixed&starting-point-node-id=307%3A3582&page-id=0%3A1&embed-host=share&hide-ui=1&footer=0";

const problemPoints = [
  {
    title: "Too many separate controls",
    text: "Users have to move between different apps and device systems to manage everyday tasks."
  },
  {
    title: "Important information is easy to miss",
    text: "Safety and home-status updates can be buried when users need reassurance quickly."
  },
  {
    title: "Care can become intrusive",
    text: "Families need ways to check on loved ones without turning the home into a surveillance system."
  }
];

const designPrinciples = [
  {
    title: "Calm, not clinical",
    text: "Keep the language clear and the visual cues soft, so the experience feels reassuring rather than technical."
  },
  {
    title: "Designed around routines, not devices",
    text: "Organize the experience around everyday rooms and routines instead of making people manage one device at a time."
  },
  {
    title: "Reassurance at a glance",
    text: "Keep important home, safety, and caregiving information easy to find and understand."
  }
];

const competitorAnalysis = [
  {
    product: "Google Home",
    logo: "/images/projects/omvia/google.png",
    logoAlt: "Google Home logo",
    strength: "Strong device integration across a broad smart-home ecosystem.",
    opportunity: "Routine information and common actions can become buried across multiple layers."
  },
  {
    product: "Samsung SmartThings",
    logo: "/images/projects/omvia/samsung.png",
    logoAlt: "Samsung SmartThings logo",
    strength: "Powerful automation and deep control for advanced users.",
    opportunity: "The technical depth can make everyday tasks harder for less technical users."
  }
];

const researchInsights = [
  {
    title: "People think in routines, not devices",
    observation:
      "Busy households think about moments like school mornings, bedtime, or leaving home rather than individual switches and devices.",
    implication:
      "Organize the experience around routines and rooms so everyday tasks feel simpler and more familiar."
  },
  {
    title: "Safety information needs to be glanceable",
    observation:
      "People checking their home remotely want quick reassurance, but important status information can be difficult to find.",
    implication:
      "Make home status and Secure Home controls easy to find, so users can quickly understand what is happening."
  },
  {
    title: "Caregiving should not feel like surveillance",
    observation:
      "Caregivers want meaningful updates without constantly watching or intruding on a loved one’s privacy.",
    implication:
      "Use passive Wellness Checks to provide reassurance without making users feel watched."
  }
];

const userSolutions = [
  {
    user: "Busy household",
    role: "Everyday routines",
    problem: "Manage a busy home without jumping between apps.",
    solution: "Room-based dashboard with routines that group everyday actions together.",
    feature: "Routines",
    note: "Turns scattered device controls into one clearer household flow."
  },
  {
    user: "Remote homeowner",
    role: "Away from home",
    problem: "Get quick reassurance without digging through the app.",
    solution: "Glanceable home status with a clear Secure Home action.",
    feature: "Secure Home",
    note: "Makes important safety information easier to understand from a distance."
  },
  {
    user: "Family caregiver",
    role: "Supporting a loved one",
    problem: "Know a loved one is safe without intrusive monitoring.",
    solution: "Passive Wellness Checks that surface meaningful changes and alerts.",
    feature: "Wellness Checks",
    note: "Supports caregiving with reassurance, not surveillance."
  }
];

const palette = [
  {
    name: "Trust Blue",
    value: "#2E48C8",
    text: "Key actions and primary UI elements."
  },
  {
    name: "Calming Lavender",
    value: "#D5C7F7",
    text: "Adds a softer, more relaxed feel."
  },
  {
    name: "Soft Cyan",
    value: "#65D1E4",
    text: "Adds freshness and subtle highlights."
  },
  {
    name: "Clean White",
    value: "#FFFFFF",
    text: "Keeps layouts open and breathable."
  },
  {
    name: "Alert Orange",
    value: "#FFB937",
    text: "Highlights important states and actions."
  }
];

const hifiSections = [
  {
    title: "Sign In / Onboarding",
