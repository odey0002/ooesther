    variant: "nine",
    highlights: [
      {
        title: "Recommended Routine",
        text: "Ready-made routines group multiple device actions into one tap."
      },
      {
        title: "Custom Routine Builder",
        text: "Create routines around time, motion, or voice."
      },
      {
