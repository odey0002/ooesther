      {
        src: "/images/projects/omvia/devices-3.png",
        alt: "Omvia device detail screen",
        label: "List View"
      }
    ]
  },
  {
    title: "Settings",
    intro:
      "Settings brings account security, home access, voice assistants, and privacy into one place.",
    variant: "six",
    highlights: [
      {
        title: "Home Access Management",
        text: "Manage family, guest, and caregiver access from one place."
      },
      {
        title: "Privacy & Security",
        text: "Keep security, permissions, and personal information easy to manage."
      }
    ],
    screens: [
      {
        src: "/images/projects/omvia/settings-1.png",
        alt: "Omvia settings screen one",
