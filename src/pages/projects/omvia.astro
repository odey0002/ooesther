---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectPager from "../../components/ProjectPager.astro";
import { getProjectBySlug } from "../../data/projects.js";

import "../../styles/projects/omvia.css";

const project = getProjectBySlug("omvia");

const prototypeUrl = "https://www.figma.com/proto/n1HrOSWuPKgLjaJ5UhpT6Q/smart-home-app-mine--Copy-?node-id=307-3582&p=f&viewport=1189%2C-3634%2C0.21&t=cr2ZpQNTxKqv4qNN-1&scaling=scale-down&content-scaling=fixed&starting-point-node-id=307%3A3582&page-id=0%3A1";
const prototypeEmbedSrc = "https://embed.figma.com/proto/n1HrOSWuPKgLjaJ5UhpT6Q/smart-home-app-mine--Copy-?node-id=307-3582&p=f&viewport=1189%2C-3634%2C0.21&scaling=scale-down&content-scaling=fixed&starting-point-node-id=307%3A3582&page-id=0%3A1&embed-host=share&hide-ui=1&footer=0";

const problemPoints = [
  {
    title: "Too many separate controls",
    text: "Users have to move between different apps and device systems to manage everyday tasks."
  },
  {
    title: "Important information is easy to miss",
    text: "Safety and home-status updates can be buried when users need reassurance quickly."
  },
  {
    title: "Care can become intrusive",
    text: "Families need ways to check on loved ones without turning the home into a surveillance system."
  }
];

const designPrinciples = [
  {
    title: "Calm, not clinical",
    text: "Keep the language clear and the visual cues soft, so the experience feels reassuring rather than technical."
  },
  {
    title: "Designed around routines, not devices",
    text: "Organize the experience around everyday rooms and routines instead of making people manage one device at a time."
  },
  {
    title: "Reassurance at a glance",
    text: "Keep important home, safety, and caregiving information easy to find and understand."
  }
];

const competitorAnalysis = [
  {
    product: "Google Home",
    logo: "/images/projects/omvia/google.png",
    logoAlt: "Google Home logo",
    strength: "Strong device integration across a broad smart-home ecosystem.",
    opportunity: "Routine information and common actions can become buried across multiple layers."
  },
  {
    product: "Samsung SmartThings",
    logo: "/images/projects/omvia/samsung.png",
    logoAlt: "Samsung SmartThings logo",
    strength: "Powerful automation and deep control for advanced users.",
    opportunity: "The technical depth can make everyday tasks harder for less technical users."
  }
];

const userSolutions = [
  {
    user: "Busy household",
    role: "Everyday routines",
    problem: "Manage a busy home without jumping between apps.",
    solution: "Reusable routines group common household actions for a quick start.",
    feature: "Routines",
    note: "Turns scattered device controls into one clearer household flow."
  },
  {
    user: "Remote homeowner",
    role: "Away from home",
    problem: "Get quick reassurance without digging through the app.",
    solution: "Home status and safety controls in one place for remote checks.",
    feature: "Secure Home",
    note: "Makes important safety information easier to understand from a distance."
  },
  {
    user: "Family caregiver",
    role: "Supporting a loved one",
    problem: "Know a loved one is safe without intrusive monitoring.",
    solution: "Meaningful updates and alerts when something may need attention.",
    feature: "Wellness Checks",
    note: "Supports caregiving with reassurance, not surveillance."
  }
];

const palette = [
  {
    name: "Trust Blue",
    value: "#2E48C8",
    text: "Key actions and primary UI elements."
  },
  {
    name: "Calming Lavender",
    value: "#D5C7F7",
    text: "Adds a softer, more relaxed feel."
  },
  {
    name: "Soft Cyan",
    value: "#65D1E4",
    text: "Adds freshness and subtle highlights."
  },
  {
    name: "Clean White",
    value: "#FFFFFF",
    text: "Keeps layouts open and breathable."
  },
  {
    name: "Alert Orange",
    value: "#FFB937",
    text: "Highlights important states and actions."
  }
];

const hifiSections = [
  {
    title: "Sign In / Onboarding",
    intro:
      "Guides users from introduction and device setup to secure sign in.",
    variant: "five",
    screens: [
      {
        src: "/images/projects/omvia/onboarding-1.png",
        alt: "Omvia logo opening screen",
        label: "Brand Entry"
      },
      {
        src: "/images/projects/omvia/onboarding-2.png",
        alt: "Omvia welcome onboarding screen",
        label: "Welcome"
      },
      {
        src: "/images/projects/omvia/onboarding-3.png",
        alt: "Omvia onboarding preference screen",
        label: "User Need"
      },
      {
        src: "/images/projects/omvia/onboarding-4.png",
        alt: "Omvia device connection onboarding screen",
        label: "Setup"
      },
      {
        src: "/images/projects/omvia/login.png",
        alt: "Omvia login screen",
        label: "Sign In"
      }
    ]
  },
  {
    title: "Routines",
    intro:
      "Brings repeated device actions, custom triggers, and Wellness Checks into one setup flow.",
    variant: "nine",
    screens: [
      {
        src: "/images/projects/omvia/routines-main.png",
        alt: "Omvia routines main screen",
        label: "Routine Hub"
      },
      {
        src: "/images/projects/omvia/routines-1.png",
        alt: "Omvia Morning Rush routine screen one",
        label: "Morning Rush"
      },
      {
        src: "/images/projects/omvia/routines-2.png",
        alt: "Omvia Morning Rush routine screen two",
        label: "Routine Detail"
      },
      {
        src: "/images/projects/omvia/routines-3.png",
        alt: "Omvia Morning Rush routine screen three",
        label: "Triggers"
      },
      {
        src: "/images/projects/omvia/routines-4.png",
        alt: "Omvia Morning Rush routine screen four",
        label: "Wellness Setup"
      },
      {
        src: "/images/projects/omvia/routines-5.png",
        alt: "Omvia Morning Rush routine screen five",
        label: "Room Selection"
      },
      {
        src: "/images/projects/omvia/routines-6.png",
        alt: "Omvia Morning Rush routine screen six",
        label: "Schedule"
      },
      {
        src: "/images/projects/omvia/routines-7.png",
        alt: "Omvia Morning Rush routine screen seven",
        label: "Review"
      },
      {
        src: "/images/projects/omvia/routines-8.png",
        alt: "Omvia Morning Rush routine screen eight",
        label: "Active"
      }
    ]
  },
  {
    title: "Devices",
    intro:
      "Organizes connected devices by room and provides a clear way to secure the home.",
    variant: "three",
    screens: [
      {
        src: "/images/projects/omvia/devices-1.png",
        alt: "Omvia devices grid view screen",
        label: "Grid View"
      },
      {
        src: "/images/projects/omvia/devices-2.png",
        alt: "Omvia devices list view screen",
        label: "Active Controls"
      },
      {
        src: "/images/projects/omvia/devices-3.png",
        alt: "Omvia device detail screen",
        label: "List View"
      }
    ]
  },
  {
    title: "Settings",
    intro:
      "Brings account security, access, voice assistants, and privacy controls into one place.",
    variant: "six",
    screens: [
      {
        src: "/images/projects/omvia/settings-1.png",
        alt: "Omvia settings screen one",
        label: "Settings Home"
      },
      {
        src: "/images/projects/omvia/settings-2.png",
        alt: "Omvia settings screen two",
        label: "Voice Assistant"
      },
      {
        src: "/images/projects/omvia/settings-3.png",
        alt: "Omvia settings screen three",
        label: "Security"
      },
      {
        src: "/images/projects/omvia/settings-4.png",
        alt: "Omvia settings screen four",
        label: "Access"
      },
      {
        src: "/images/projects/omvia/settings-5.png",
        alt: "Omvia settings screen five",
        label: "Password"
      },
      {
        src: "/images/projects/omvia/settings-6.png",
        alt: "Omvia settings screen six",
        label: "Account Details"
      }
    ]
  },
  {
    title: "Alerts",
    intro:
      "Helps users understand what happened, judge urgency, and respond quickly.",
    variant: "two",
    screens: [
      {
        src: "/images/projects/omvia/alert-1.png",
        alt: "Omvia alert screen",
        label: "Alert"
      },
      {
        src: "/images/projects/omvia/alert-2.png",
        alt: "Omvia alert detail screen",
        label: "Respond"
