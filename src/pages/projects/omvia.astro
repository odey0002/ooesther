  <script>
    function setupOmviaBoards() {
      const dialog = document.querySelector<HTMLDialogElement>('.omvia-board-dialog');
      const imageContainer = dialog?.querySelector<HTMLDivElement>('.omvia-board-dialog__image');
      if (!dialog || !imageContainer || dialog.dataset.ready) return;
      dialog.dataset.ready = 'true';
      let opener: HTMLButtonElement | null = null;
      document.querySelectorAll<HTMLButtonElement>('.omvia-board-open').forEach((button) => {
        const thumbnail = button.querySelector('img');
        if (!thumbnail) return;
        button.setAttribute('aria-label', `Enlarge: ${thumbnail.alt}`);
        button.addEventListener('click', () => {
          const enlarged = new Image();
          enlarged.src = thumbnail.currentSrc || thumbnail.src;
          enlarged.alt = thumbnail.alt;
          imageContainer.replaceChildren(enlarged);
          opener = button;
          dialog.showModal();
          document.documentElement.classList.add('omvia-board-is-open');
          imageContainer.scrollTo(0, 0);
        });
      });
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
      });
      dialog.addEventListener('close', () => {
        document.documentElement.classList.remove('omvia-board-is-open');
        opener?.focus({ preventScroll: true });
      });
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.classList.remove('omvia-board-is-open');
      }, { once: true });
    }
    setupOmviaBoards();
    document.addEventListener('astro:page-load', setupOmviaBoards);
  </script>
