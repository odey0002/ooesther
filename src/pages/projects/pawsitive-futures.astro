---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PawsitiveImage from "../../components/PawsitiveImage.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectPager from "../../components/ProjectPager.astro";
import { getProjectBySlug } from "../../data/projects.js";
const project = getProjectBySlug("pawsitive-futures");
// Live responsive website.
const liveSiteUrl = "https://odey0002.github.io/pawsitive-futures/";
const priorities = [
  { title: "Easier Pet Discovery", need: "Prospective adopters wanted detailed pet information and an easier way to find animals that matched what they were looking for.", solution: "Added searchable pet listings with Dogs, Cats, and Rabbits filters, result counts, clear feedback states, and structured pet information to make browsing easier." },
  { title: "Clearer Ways to Get Involved", need: "Volunteers and foster caregivers needed clearer information about available roles, expectations, requirements, and how to take the next step.", solution: "Created a dedicated Get Involved experience that organizes volunteering, fostering, support options, expectations, resources, and interest submission into clearer pathways." },
  { title: "More Trust & Connection", need: "Participants looked for success stories, community activity, useful resources, and clearer ways to understand and connect with the rescue.", solution: "Used success stories, resources, events and workshops, support options, FAQs, and direct contact pathways to make the rescue feel more informative and connected." },
];
const findings = [
  ["Colour hierarchy", "Sections needed stronger visual distinction."],
  ["CTA visibility", "Buttons needed more prominence and consistent states."],
  ["Visual engagement", "The interface needed stronger supporting visual elements."],
  ["Contact hierarchy", "The contact form needed clearer definition."],
];
---
<BaseLayout title="Pawsitive Futures — UX/UI & Front-End Case Study" description={project.description}>
  <Header />
  <main class="project-detail pawsitive">
    <section class="project-hero site-shell section">
      <a href="/work" class="project-back-link">← Work</a>
      <div class="project-hero__intro">
        <p class="project-number">{project.number}</p>
        <div><p class="project-label">{project.category} · {project.year}</p><h1>{project.title}</h1><p class="project-hero__summary">{project.description}</p></div>
      </div>
      <div class="pawsitive-hero-image"><PawsitiveImage file="hero.jpg" alt="Pawsitive Futures responsive website preview" eager /></div>
      <dl class="project-facts">
        <div><dt>Role</dt><dd>UX/UI Designer &amp; Front-End Developer</dd></div>
        <div><dt>Contribution</dt><dd>Owned the project from primary research and information architecture through responsive UX/UI design, front-end development, and later visual refinement.</dd></div>
        <div><dt>Tools</dt><dd>Figma · FigJam · Lovable · HTML · CSS · JavaScript · Git · GitHub · GitHub Pages</dd></div>
        <div><dt>Timeframe</dt><dd>Nov 2024 – Mar 2025<br />Interface refinement: 2026</dd></div>
      </dl>
      <p class="eyebrow at-a-glance">Research &amp; Scope</p>
      <div class="evidence"><p><strong>9</strong>User Interviews</p><p><strong>3</strong>Audience Groups</p><p><strong class="devices">Mobile · Tablet · Desktop</strong>Responsive experience</p></div>
      {liveSiteUrl ? <a class="prototype-link" href={liveSiteUrl}>View Live Website ↗</a> : <p class="pending-link">View Live Website <span>Link coming soon</span></p>}

    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>01 / The Challenge</h2></div>
      <div class="project-section__content"><p class="project-lead">The challenge was to create one clear experience for people arriving with very different goals, from finding a pet to fostering, volunteering, donating, or learning more about adoption. The experience also needed to stay easy to navigate across mobile, tablet, and desktop.</p></div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>02 / Research</h2></div>
      <div class="project-section__content">
        <div class="subsection"><h3>Affinity Mapping</h3>
          <p>9 interviews across 3 audience groups revealed common needs around pet information, getting involved, trust, and navigation.</p>
          <figure class="interview-map"><button type="button" class="paws-board-open" aria-haspopup="dialog" aria-label="Enlarge interview synthesis affinity map"><img src="/images/projects/pawsitive-futures/research-synthesis.png" alt="Interview affinity map synthesizing notes from 3 prospective adopters, 3 staff and volunteers, and 3 supporters" loading="lazy" decoding="async" /></button></figure>
          <div class="compact-grid synthesis-findings">
            <article><h4>Clear, current pet information</h4><p>Adopters wanted detailed profiles, behavioural information, care needs, availability, and clearer guidance before making a decision.</p></article>
            <article><h4>Guided ways to take action</h4><p>Adoption, volunteering, and fostering all needed clearer steps, expectations, and supporting information.</p></article>
            <article><h4>Trust through transparency</h4><p>Participants looked for reviews, success stories, regular updates, visible community activity, and clearer information about how support makes an impact.</p></article>
          </div>
        </div>
        <div class="subsection competitive-section"><h3>Competitive Review</h3>
          <p>I reviewed three animal rescue websites to understand how they handled pet discovery, community involvement, calls to action, and trust-building content.</p>
          <div class="compact-grid competitor-review brand-competitors">
            <article>
              <div class="competitor-logo"><img src="/images/projects/pawsitive-futures/ottawa-dog-rescue-logo.png" alt="Ottawa Dog Rescue logo" loading="lazy" decoding="async" /></div>
              <h4>Ottawa Dog Rescue</h4>
              <p><span class="review-label">What works</span> Clear Donate and Featured Dog CTAs, visible navigation, impact metrics, and featured-animal storytelling made important actions and organizational impact easy to see.</p>
              <p><span class="review-label">Gap / opportunity</span> Pet discovery could be stronger with clearer hierarchy, more detailed search and filtering, adopter testimonials, and additional educational content.</p>
            </article>
            <article>
              <div class="competitor-logo"><img src="/images/projects/pawsitive-futures/ohs_logo.png" alt="Ottawa Humane Society logo" loading="lazy" decoding="async" /></div>
              <h4>Ottawa Humane Society</h4>
              <p><span class="review-label">What works</span> Strong Adopt, Donate, and Get Involved CTAs, community programs, accreditation information, and accessible navigation helped communicate credibility and participation opportunities.</p>
              <p><span class="review-label">Gap / opportunity</span> The large amount of content created an opportunity for simpler navigation and clearer organization, with more adopter testimonials supporting the experience.</p>
            </article>
            <article>
              <div class="competitor-logo"><img src="/images/projects/pawsitive-futures/paws-for-cause-logo.png" alt="Paws for Cause logo" loading="lazy" decoding="async" /></div>
              <h4>Paws for Cause</h4>
              <p><span class="review-label">What works</span> Emotional animal photography, a calm colour palette, simple navigation, and a distinctive Donate CTA created a welcoming and approachable experience.</p>
              <p><span class="review-label">Gap / opportunity</span> Animal profiles needed more detail, while search, volunteer information, testimonials, FAQs, and educational content could make the experience more useful.</p>
            </article>
          </div>
          <div class="competitive-takeaway"><h4>Key Takeaway</h4><p>The review reinforced the need to combine emotional storytelling with practical discovery tools, clearer participation pathways, and enough information for users to act with confidence.</p></div>
        </div>
        <div class="subsection research-divider"><h3>Audience Groups</h3>
          <p>The interviews highlighted three audience groups, each with different goals and information needs.</p>
          <div class="paws-audience-focus">
            <article><h4>01 — Prospective Adopter</h4><p><strong>Bola Adedapo</strong></p><p>Wants to find a suitable pet and feel confident about the adoption process.</p><p><strong>Needs</strong><br />Detailed pet profiles, behaviour and care information, clear adoption guidance, and trustworthy shelter information.</p></article>
            <article><h4>02 — Prospective Volunteer</h4><p><strong>Jim James</strong></p><p>Wants to understand where help is needed and how to get involved.</p><p><strong>Needs</strong><br />Clear volunteer roles, expectations, application steps, training resources, and up-to-date opportunities.</p></article>
            <article><h4>03 — Supporter</h4><p><strong>Keisha Jing</strong></p><p>Wants to support animal welfare and understand how their contribution makes an impact.</p><p><strong>Needs</strong><br />Clear donation and sponsorship options, community opportunities, regular updates, success stories, and transparency around impact.</p></article>
          </div>
        </div>
        <div class="subsection research-divider"><h3>Journey Map</h3><figure class="interview-map"><button type="button" class="paws-board-open" aria-haspopup="dialog" aria-label="Enlarge volunteer journey map"><img src="/images/projects/pawsitive-futures/journey-map.jpg" alt="Volunteer journey map" loading="lazy" decoding="async" /></button></figure></div>
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>03 / From Needs to Solution</h2></div>
      <div class="project-section__content">
        <p class="project-lead">The research translated into three priorities for the experience: make pet discovery easier, make ways to get involved clearer, and give visitors more reasons to trust and engage with the rescue.</p>
        <div class="paws-decisions">
          {priorities.map((item, index) => (
            <article class="paws-decision">
              <header><span class="paws-decision__number">{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3></header>
              <div class="paws-decision__body">
                <div class="paws-decision__need"><h4>Need</h4><p>{item.need}</p></div>
                <div class="paws-decision__solution"><h4>Solution</h4><p>{item.solution}</p></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>04 / Structure</h2></div>
      <div class="project-section__content">
        <div class="subsection">
          <h3>Refined Information Architecture</h3>
          <p class="project-lead">The original sitemap was broader, so the structure was refined around the main user paths and the final coded experience.</p>
          <div class="paws-sitemap"><PawsitiveImage file="paw-sitemap.png" alt="Pawsitive Futures sitemap: Home leads to Adopt, Get Involved, and Contact. Adopt contains Available Pets, Search and Filters, and Resources with Adoption Guides, Events and Workshops, and FAQs. Get Involved contains Volunteer, Foster, and Donate. Contact contains Contact Form and Contact Info." /></div>
          <p>The refined structure keeps pet discovery, participation, resources, and contact information grouped around the main tasks visitors need to complete.</p>
        </div>
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>05 / Early Design</h2></div>
      <div class="project-section__content"><p class="project-lead">Low-fidelity wireframes established the page hierarchy, responsive structure, and key paths to adoption and community involvement before visual styling was applied.</p><div class="subsection"><h3>Low-Fidelity Wireframes</h3><PawsitiveImage file="low-fi.jpg" alt="Low-fidelity mobile, tablet, and desktop wireframes" /></div></div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>06 / Initial Visual Direction</h2></div>
      <div class="project-section__content">
        <div class="subsection"><h3>Moodboard</h3><p>The original moodboard established a warm, approachable direction that remained the visual foundation of the project through the later refinement.</p><ul class="visual-keywords" aria-label="Visual direction keywords"><li>Friendly</li><li>Compassionate</li><li>Warmth</li><li>Hope</li><li>Organized</li></ul><PawsitiveImage file="moodboard.jpg" alt="Original Pawsitive Futures moodboard" /></div>
        <div class="subsection"><h3>Style Tile</h3><p>The style tile translated that direction into typography, colour, imagery, and interface treatments that continued to guide the 2026 redesign.</p><PawsitiveImage file="style-tile.jpg" alt="Original colour palette, typography, buttons, and imagery" /></div>
        <div class="subsection"><h3>Initial UI</h3><p>The first coded version established the visual foundation across Home, Adopt, and Contact.</p><div class="compact-grid">{["Home", "Adopt", "Contact"].map(name => <PawsitiveImage file={`initial-${name.toLowerCase()}.jpg`} alt={`Original desktop high-fidelity ${name} screen`} />)}</div><p>The interface was later refined and expanded in 2026, while the original visual direction and core brand language remained consistent.</p></div>
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>07 / Feedback &amp; Reassessment</h2></div>
      <div class="project-section__content"><p class="project-lead">After the first version was designed and coded, focus-group feedback and my own review highlighted four areas for improvement.</p><p>Focus-group feedback confirmed concerns around colour treatment, button visibility, visual engagement, and contact-form clarity.</p><div class="compact-grid two-columns">{findings.map(([title, copy], index) => <article class="compact-item"><span class="eyebrow">0{index + 1}</span><h3>{title}</h3><p>{copy}</p></article>)}</div><div class="feedback-comparison">
          <figure class="feedback-study feedback-study--home">
            <figcaption>Home</figcaption>
            <div class="feedback-study__canvas">
              <button type="button" class="paws-board-open" aria-haspopup="dialog" aria-label="Enlarge original Home screenshot"><img src="/images/projects/pawsitive-futures/feedback-01.jpg" alt="Original Home page before the 2026 refinement" loading="lazy" decoding="async" /></button>
              <div class="feedback-callout feedback-callout--colour"><span class="feedback-callout__line" aria-hidden="true"></span><strong>01 — Colour hierarchy</strong><p>Similar background treatments made some sections blend together.</p></div>
              <div class="feedback-callout feedback-callout--cta"><span class="feedback-callout__line" aria-hidden="true"></span><strong>02 — CTA visibility</strong><p>Primary actions needed stronger prominence and more consistent button treatment.</p></div>
              <div class="feedback-callout feedback-callout--visual"><span class="feedback-callout__line" aria-hidden="true"></span><strong>03 — Visual engagement</strong><p>Text-heavy sections needed stronger supporting visual elements.</p></div>
            </div>
          </figure>
          <figure class="feedback-study feedback-study--contact">
            <figcaption>Contact</figcaption>
            <div class="feedback-study__canvas">
              <button type="button" class="paws-board-open" aria-haspopup="dialog" aria-label="Enlarge original Contact screenshot"><img src="/images/projects/pawsitive-futures/feedback-02.jpg" alt="Original Contact page showing contact information, the Contact Us form, and address and map" loading="lazy" decoding="async" /></button>
              <div class="feedback-callout feedback-callout--contact"><span class="feedback-callout__line" aria-hidden="true"></span><strong>04 — Contact hierarchy</strong><p>The contact form needed clearer definition as the page’s main action.</p></div>
            </div>
          </figure>
        </div></div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>08 / Interface Refinement</h2></div>
      <div class="project-section__content">
        <p class="project-lead">In 2026, I revisited the interface to address the focus-group feedback while keeping the original visual direction and brand language intact.</p>
        {[
          { title: "Colour hierarchy", response: "Introduced clearer background changes, spacing, dividers, and content groupings to give sections stronger visual distinction.", file: "refinement-home", beforeRatio: 3456 / 5582, afterRatio: 2522 / 3276, before: "Original Home section hierarchy", after: "Refined Home section hierarchy" },
          { title: "CTA visibility", response: "Standardized primary and secondary action treatments to create a clearer and more consistent hierarchy across the experience.", file: "refinement-cta", beforeRatio: 3456 / 2823, afterRatio: 2522 / 1736, before: "Original How You Can Help actions", after: "Refined primary and secondary actions" },
          { title: "Visual engagement", response: "Expanded photography, editorial image treatments, success stories, and supporting visual elements to reduce text-heavy sections.", file: "visual-storytelling", beforeRatio: 3456 / 2051, afterRatio: 2522 / 1443, before: "Original text-heavy Why We Care section", after: "Refined Luna success story with photography and story content" },
          { title: "Contact hierarchy", response: "Separated contact information from the enquiry form and gave the form clearer definition as the page’s primary action.", file: "refinement-contact", beforeRatio: 3456 / 3762, afterRatio: 2064 / 1622, before: "Original Contact form hierarchy", after: "Refined enquiry form with a distinct heading and primary action" },
        ].map((comparison, index) => (
          <div class="subsection research-divider">
            <h3>{String(index + 1).padStart(2, "0")} — {comparison.title}</h3>
            <p><strong>Refinement:</strong><br />{comparison.response}</p>
            <div class="compact-grid two-columns refinement-comparison" style={`--before-ratio: ${comparison.beforeRatio}fr; --after-ratio: ${comparison.afterRatio}fr;`}>
              <div><h4>Before</h4><PawsitiveImage file={`${comparison.file}-before.jpg`} alt={comparison.before} /></div>
              <div><h4>After</h4><PawsitiveImage file={`${comparison.file}-after.jpg`} alt={comparison.after} /></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>09 / Final Responsive Experience</h2></div>
      <div class="project-section__content"><p class="project-lead">The refined experience brings pet discovery, search and filtering, adoption resources, success stories, events, and ways to foster, volunteer, and donate together across desktop, tablet, and mobile.</p>
          <div class="subsection final-showcase"><h3>Desktop</h3>
          <div class="final-showcase__grid final-showcase__grid--desktop">
          <div class="final-showcase__page final-showcase__page--featured"><h4><span>01</span> Home</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Home desktop screenshot"><img src="/images/projects/pawsitive-futures/final-home-desktop.jpg" alt="Final Home page at desktop width" loading="lazy" decoding="async" /></button></div>
          <div class="final-showcase__page final-showcase__page--featured"><h4><span>02</span> Adopt</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Adopt desktop screenshot"><img src="/images/projects/pawsitive-futures/final-adopt-desktop.jpg" alt="Final Adopt page at desktop width" loading="lazy" decoding="async" /></button></div>
          <div class="final-showcase__page"><h4><span>03</span> Get Involved</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Get Involved desktop screenshot"><img src="/images/projects/pawsitive-futures/final-get-involved-desktop.jpg" alt="Final Get Involved page at desktop width" loading="lazy" decoding="async" /></button></div>
          <div class="final-showcase__page"><h4><span>04</span> Contact</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Contact desktop screenshot"><img src="/images/projects/pawsitive-futures/final-contact-desktop.jpg" alt="Final Contact page at desktop width" loading="lazy" decoding="async" /></button></div>
          </div></div>
          <div class="subsection final-showcase"><h3>Tablet</h3>
          <div class="final-showcase__grid final-showcase__grid--tablet">
          <div class="final-showcase__page"><h4><span>01</span> Home</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Home tablet screenshot"><img src="/images/projects/pawsitive-futures/final-home-tablet.jpg" alt="Final Home page at tablet width" loading="lazy" decoding="async" /></button></div>
          <div class="final-showcase__page"><h4><span>02</span> Adopt</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Adopt tablet screenshot"><img src="/images/projects/pawsitive-futures/final-adopt-tablet.jpg" alt="Final Adopt page at tablet width" loading="lazy" decoding="async" /></button></div>
          <div class="final-showcase__page"><h4><span>03</span> Get Involved</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Get Involved tablet screenshot"><img src="/images/projects/pawsitive-futures/final-get-involved-tablet.jpg" alt="Final Get Involved page at tablet width" loading="lazy" decoding="async" /></button></div>
          <div class="final-showcase__page"><h4><span>04</span> Contact</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Contact tablet screenshot"><img src="/images/projects/pawsitive-futures/final-contact-tablet.jpg" alt="Final Contact page at tablet width" loading="lazy" decoding="async" /></button></div>
          </div></div>
          <div class="subsection final-showcase"><h3>Mobile</h3>
          <div class="final-showcase__grid final-showcase__grid--mobile">
          <div class="final-showcase__page"><h4><span>01</span> Home</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Home mobile screenshot"><img src="/images/projects/pawsitive-futures/final-home-mobile.jpg" alt="Final Home page at mobile width" loading="lazy" decoding="async" /></button></div>
          <div class="final-showcase__page"><h4><span>02</span> Adopt</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Adopt mobile screenshot"><img src="/images/projects/pawsitive-futures/final-adopt-mobile.jpg" alt="Final Adopt page at mobile width" loading="lazy" decoding="async" /></button></div>
          <div class="final-showcase__page"><h4><span>03</span> Get Involved</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Get Involved mobile screenshot"><img src="/images/projects/pawsitive-futures/final-get-involved-mobile.jpg" alt="Final Get Involved page at mobile width" loading="lazy" decoding="async" /></button></div>
          <div class="final-showcase__page"><h4><span>04</span> Contact</h4>
          <button type="button" class="paws-board-open" aria-label="Enlarge final Contact mobile screenshot"><img src="/images/projects/pawsitive-futures/final-contact-mobile.jpg" alt="Final Contact page at mobile width" loading="lazy" decoding="async" /></button></div>
          </div></div>
          
          <div class="subsection responsive-notes">
            <h3>Responsive behaviour</h3>
            <p>The layout was adjusted for desktop, tablet, and mobile. Columns reduce as the screen gets smaller. Content stacks on mobile. Spacing and text sizes were adjusted for readability. Buttons and controls were kept easy to use on smaller screens.</p>
            <p>The desktop navigation changes to a compact menu on smaller screens to reduce crowding.</p>
            <div class="responsive-notes__grid">
              <div><h4>Home</h4><p>The two-column hero stacks on smaller screens. Statistics and event content simplify as the screen narrows. The success story also stacks on mobile.</p></div>
              <div><h4>Adopt</h4><p>Pet cards move from three columns on desktop to two on tablet and one on mobile. Filters wrap on tablet and become horizontally scrollable on mobile.</p></div>
              <div><h4>Get Involved</h4><p>The hero changes from two columns to one. Volunteer, Foster, Donate, and form content stack as the screen gets smaller.</p></div>
              <div><h4>Contact</h4><p>Contact information and the form sit side by side on desktop, then stack on tablet and mobile.</p></div>
            </div>
          </div>
</div>
      </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>10 / Build &amp; Implementation</h2></div>
      <div class="project-section__content">
        <p class="project-lead">I built the refined design as a responsive website using HTML, CSS, and JavaScript, then deployed it with GitHub Pages.</p>
        <div class="compact-grid two-columns">
          <div class="compact-item"><h3>Stack</h3><p>HTML · CSS · JavaScript</p></div>
          <div class="compact-item"><h3>Workflow</h3><p>Git · GitHub · GitHub Pages</p></div>
        </div>
        <p>The build included responsive navigation, reusable styling, pet search and filtering, result feedback, form interactions, and other front-end behaviour across the experience.</p>
        <div class="subsection pet-search-demo">
          <h3>Pet Search &amp; Filtering</h3>
          {[
            { title: "01 — All Pets", file: "pet-search-all.jpg", description: "Default state with all six featured pets visible." },
            { title: "02 — Filtered Results", file: "pet-search-filtered.jpg", description: "Dogs selected, reducing the results to the two matching pets." },
            { title: "03 — No Results", file: "pet-search-no-results.jpg", description: "A search with no matches, showing the result count and empty-state feedback." },
          ].map((state) => (
            <figure class="pet-search-state">
              <figcaption><h4>{state.title}</h4><p>{state.description}</p></figcaption>
              <button type="button" class="paws-board-open" aria-label={`Enlarge ${state.title} screenshot`}>
                <img src={`/images/projects/pawsitive-futures/${state.file}`} alt={state.description} loading="lazy" decoding="async" />
              </button>
            </figure>
          ))}
          <p class="pet-search-caption">JavaScript handles pet search, category filters, result counts, and feedback when no matches are found.</p>
        </div>
        <aside class="implementation-note"><p>This is a front-end implementation. The forms show confirmation messages, but they are not connected to a backend. Pet information is also stored directly in the site rather than in a live database or CMS.</p></aside>
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>11 / Outcome &amp; Reflection</h2></div>
      <div class="project-section__content"><p class="project-lead">Pawsitive Futures resulted in a fully designed and developed responsive website that brings pet discovery, adoption guidance, resources, and community involvement into one experience. Revisiting the interface later allowed me to improve the experience while keeping the original visual direction and research-led structure.</p>
        {liveSiteUrl ? <a class="prototype-link" href={liveSiteUrl}>View Live Website ↗</a> : <p class="pending-link">View Live Website <span>Link coming soon</span></p>}
        <div class="subsection outcome-reflection"><h3>Reflection</h3><p>Building the first version showed how responsive behaviour, content density, and visual hierarchy can reveal issues that are less obvious in static mockups. Revisiting the project also showed the value of using feedback to improve an existing experience rather than starting over.</p><p>If I continued the project, I would test the refined experience with users and explore connecting pet information and forms to a live backend.</p></div>
        <ProjectPager currentSlug="pawsitive-futures" />
      </div>
    </section>
  </main>
  <dialog class="paws-board-dialog" aria-label="Enlarged project image">
    <form method="dialog" class="paws-board-dialog__toolbar">
      <button type="button" class="paws-board-dialog__zoom" aria-pressed="false">View actual size</button>
      <button class="paws-board-dialog__close" autofocus>Close ×</button>
    </form>
    <div class="paws-board-dialog__image"></div>
  </dialog>

  <script>
    function setupPawsBoards() {
      const dialog = document.querySelector<HTMLDialogElement>('.paws-board-dialog');
      const imageContainer = dialog?.querySelector<HTMLDivElement>('.paws-board-dialog__image');
      if (!dialog || !imageContainer || dialog.dataset.ready) return;
      dialog.dataset.ready = 'true';
      const zoom = dialog.querySelector<HTMLButtonElement>('.paws-board-dialog__zoom');
      function setZoom(actualSize: boolean) {
        imageContainer!.classList.toggle('is-actual-size', actualSize);
        if (zoom) {
          zoom.textContent = actualSize ? 'Fit to window' : 'View actual size';
          zoom.setAttribute('aria-pressed', String(actualSize));
        }
        imageContainer!.scrollTo(0, 0);
      }
      zoom?.addEventListener('click', () => {
        setZoom(!imageContainer.classList.contains('is-actual-size'));
      });
      let opener: HTMLButtonElement | null = null;
      document.querySelectorAll<HTMLButtonElement>('.paws-board-open').forEach((button) => {
        const thumbnail = button.querySelector('img');
        if (!thumbnail) return;
        button.setAttribute('aria-label', `Enlarge: ${thumbnail.alt}`);
        button.addEventListener('click', () => {
          const enlarged = new Image();
          enlarged.src = thumbnail.currentSrc || thumbnail.src;
          enlarged.alt = thumbnail.alt;
          imageContainer.replaceChildren(enlarged);
          setZoom(false);
          opener = button;
          dialog.showModal();
          document.documentElement.classList.add('paws-board-is-open');
          imageContainer.scrollTo(0, 0);
        });
      });
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
      });
      dialog.addEventListener('close', () => {
        document.documentElement.classList.remove('paws-board-is-open');
        opener?.focus({ preventScroll: true });
      });
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.classList.remove('paws-board-is-open');
      }, { once: true });
    }
    setupPawsBoards();
    document.addEventListener('astro:page-load', setupPawsBoards);
  </script>
  <Footer />
</BaseLayout>
