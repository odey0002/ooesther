---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PawsitiveImage from "../../components/PawsitiveImage.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectPager from "../../components/ProjectPager.astro";
import { getProjectBySlug } from "../../data/projects.js";
const project = getProjectBySlug("pawsitive-futures");
// Live responsive website.
const liveSiteUrl = "https://odey0002.github.io/pawsitive-futures/";
const priorities = [
  { title: "Easier Pet Discovery", need: "Prospective adopters wanted detailed pet information and an easier way to find animals that matched what they were looking for.", solution: "Added searchable pet listings with Dogs, Cats, and Rabbits filters, result counts, clear feedback states, and structured pet information to make browsing easier." },
  { title: "Clearer Ways to Get Involved", need: "Volunteers and foster caregivers needed clearer information about available roles, expectations, requirements, and how to take the next step.", solution: "Created a dedicated Get Involved experience that organizes volunteering, fostering, support options, expectations, resources, and interest submission into clearer pathways." },
  { title: "More Trust & Connection", need: "Participants looked for success stories, community activity, useful resources, and clearer ways to understand and connect with the rescue.", solution: "Used success stories, resources, events and workshops, support options, FAQs, and direct contact pathways to make the rescue feel more informative and connected." },
];
const findings = [
  ["Colour hierarchy", "Sections needed stronger visual distinction."],
  ["CTA visibility", "Buttons needed more prominence and consistent states."],
  ["Visual engagement", "The interface needed stronger supporting visual elements."],
  ["Contact hierarchy", "The contact form needed clearer definition."],
];
---
<BaseLayout title="Pawsitive Futures — UX/UI & Front-End Case Study" description={project.description}>
  <Header />
  <main class="project-detail pawsitive">
    <section class="project-hero site-shell section">
      <a href="/work" class="project-back-link">← Work</a>
      <div class="project-hero__intro">
        <p class="project-number">{project.number}</p>
        <div><p class="project-label">{project.category} · {project.year}</p><h1>{project.title}</h1><p class="project-hero__summary">{project.description}</p></div>
      </div>
      <div class="pawsitive-hero-image"><PawsitiveImage file="hero.jpg" alt="Pawsitive Futures responsive website preview" eager /></div>
      <dl class="project-facts">
        <div><dt>Role</dt><dd>UX/UI Designer &amp; Front-End Developer</dd></div>
        <div><dt>Contribution</dt><dd>Owned the project from primary research and information architecture through responsive UX/UI design, front-end development, and later visual refinement.</dd></div>
        <div><dt>Tools</dt><dd>Figma · FigJam · Lovable · HTML · CSS · JavaScript · Git · GitHub · GitHub Pages</dd></div>
        <div><dt>Timeframe</dt><dd>Nov 2024 – Mar 2025<br />Interface refinement: 2026</dd></div>
      </dl>
      <p class="eyebrow at-a-glance">Research &amp; Scope</p>
      <div class="evidence"><p><strong>9</strong>User Interviews</p><p><strong>3</strong>Audience Groups</p><p><strong class="devices">Mobile · Tablet · Desktop</strong>Responsive experience</p></div>
      {liveSiteUrl ? <a class="prototype-link" href={liveSiteUrl}>View Live Website ↗</a> : <p class="pending-link">View Live Website <span>Link coming soon</span></p>}

    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>01 / The Challenge</h2></div>
      <div class="project-section__content"><p class="project-lead">The challenge was to create one clear experience for people arriving with very different goals, from finding a pet to fostering, volunteering, donating, or learning more about adoption. The experience also needed to stay easy to navigate across mobile, tablet, and desktop.</p></div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>02 / Research</h2></div>
      <div class="project-section__content">
        <div class="subsection"><h3>Affinity Mapping</h3>
          <p>9 interviews across 3 audience groups revealed common needs around pet information, getting involved, trust, and navigation.</p>
          <figure class="interview-map"><button type="button" class="paws-board-open" aria-haspopup="dialog" aria-label="Enlarge interview synthesis affinity map"><img src="/images/projects/pawsitive-futures/research-synthesis.png" alt="Interview affinity map synthesizing notes from 3 prospective adopters, 3 staff and volunteers, and 3 supporters" loading="lazy" decoding="async" /></button></figure>
          <div class="compact-grid synthesis-findings">
            <article><h4>Clear, current pet information</h4><p>Adopters wanted detailed profiles, behavioural information, care needs, availability, and clearer guidance before making a decision.</p></article>
            <article><h4>Guided ways to take action</h4><p>Adoption, volunteering, and fostering all needed clearer steps, expectations, and supporting information.</p></article>
            <article><h4>Trust through transparency</h4><p>Participants looked for reviews, success stories, regular updates, visible community activity, and clearer information about how support makes an impact.</p></article>
          </div>
        </div>
        <div class="subsection competitive-section"><h3>Competitive Review</h3>
          <p>I reviewed three animal rescue websites to understand how they handled pet discovery, community involvement, calls to action, and trust-building content.</p>
          <div class="compact-grid competitor-review brand-competitors">
            <article>
              <div class="competitor-logo"><img src="/images/projects/pawsitive-futures/ottawa-dog-rescue-logo.png" alt="Ottawa Dog Rescue logo" loading="lazy" decoding="async" /></div>
              <h4>Ottawa Dog Rescue</h4>
              <p><span class="review-label">What works</span> Clear Donate and Featured Dog CTAs, visible navigation, impact metrics, and featured-animal storytelling made important actions and organizational impact easy to see.</p>
              <p><span class="review-label">Gap / opportunity</span> Pet discovery could be stronger with clearer hierarchy, more detailed search and filtering, adopter testimonials, and additional educational content.</p>
            </article>
            <article>
              <div class="competitor-logo"><img src="/images/projects/pawsitive-futures/ohs_logo.png" alt="Ottawa Humane Society logo" loading="lazy" decoding="async" /></div>
              <h4>Ottawa Humane Society</h4>
              <p><span class="review-label">What works</span> Strong Adopt, Donate, and Get Involved CTAs, community programs, accreditation information, and accessible navigation helped communicate credibility and participation opportunities.</p>
              <p><span class="review-label">Gap / opportunity</span> The large amount of content created an opportunity for simpler navigation and clearer organization, with more adopter testimonials supporting the experience.</p>
            </article>
            <article>
              <div class="competitor-logo"><img src="/images/projects/pawsitive-futures/paws-for-cause-logo.png" alt="Paws for Cause logo" loading="lazy" decoding="async" /></div>
              <h4>Paws for Cause</h4>
              <p><span class="review-label">What works</span> Emotional animal photography, a calm colour palette, simple navigation, and a distinctive Donate CTA created a welcoming and approachable experience.</p>
              <p><span class="review-label">Gap / opportunity</span> Animal profiles needed more detail, while search, volunteer information, testimonials, FAQs, and educational content could make the experience more useful.</p>
            </article>
          </div>
          <div class="competitive-takeaway"><h4>Key Takeaway</h4><p>The review reinforced the need to combine emotional storytelling with practical discovery tools, clearer participation pathways, and enough information for users to act with confidence.</p></div>
        </div>
        <div class="subsection research-divider"><h3>Audience Groups</h3>
          <p>The interviews highlighted three groups the experience needed to support, each with different goals and information needs.</p>
          <div class="paws-audience-focus">
            <article><h4>Prospective Adopters</h4><p><strong>Goal</strong><br />Find a suitable pet and understand what adoption involves.</p><p><strong>Needs</strong><br />Current pet profiles, behaviour and care information, clear adoption steps, and guidance before making a decision.</p></article>
            <article><h4>Staff &amp; Volunteers</h4><p><strong>Goal</strong><br />Find clear ways to volunteer, foster, or work with the rescue.</p><p><strong>Needs</strong><br />Role expectations, requirements, training information, and straightforward application steps.</p></article>
            <article><h4>Supporters</h4><p><strong>Goal</strong><br />Understand how they can contribute and what difference their support makes.</p><p><strong>Needs</strong><br />Clear donation and sponsorship options, community opportunities, impact updates, and transparent information.</p></article>
          </div>
        </div>
        <div class="subsection research-divider"><h3>Journey Map</h3><figure class="interview-map"><button type="button" class="paws-board-open" aria-haspopup="dialog" aria-label="Enlarge volunteer journey map"><img src="/images/projects/pawsitive-futures/journey-map.jpg" alt="Volunteer journey map" loading="lazy" decoding="async" /></button></figure></div>
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>03 / From Needs to Solution</h2></div>
      <div class="project-section__content">
        <p class="project-lead">The research translated into three priorities for the experience: make pet discovery easier, make ways to get involved clearer, and give visitors more reasons to trust and engage with the rescue.</p>
        <div class="paws-decisions">
          {priorities.map((item, index) => (
            <article class="paws-decision">
              <header><span class="paws-decision__number">{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3></header>
              <div class="paws-decision__body">
                <div class="paws-decision__need"><h4>Need</h4><p>{item.need}</p></div>
                <div class="paws-decision__solution"><h4>Solution</h4><p>{item.solution}</p></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>04 / Structure</h2></div>
      <div class="project-section__content">
        <div class="subsection">
          <h3>Information Architecture</h3>
          <p class="project-lead">The site structure was organized around the main tasks identified in research: finding a pet, getting involved, accessing resources, and contacting the rescue.</p>
          <div class="paws-sitemap"><PawsitiveImage file="paw-sitemap.png" alt="Pawsitive Futures sitemap: Home leads to Adopt, Get Involved, and Contact. Adopt contains Available Pets, Search and Filters, and Resources with Adoption Guides, Events and Workshops, and FAQs. Get Involved contains Volunteer, Foster, and Donate. Contact contains Contact Form and Contact Info." /></div>
          <p>Grouping related content under three main pathways helped keep pet discovery, participation, resources, and contact information easier to understand.</p>
        </div>
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>05 / Early Design</h2></div>
      <div class="project-section__content"><p class="project-lead">Low-fidelity wireframes established the page hierarchy, responsive structure, and key paths to adoption and community involvement before visual styling was applied.</p><div class="subsection"><h3>Low-Fidelity Wireframes</h3><PawsitiveImage file="low-fi.jpg" alt="Low-fidelity mobile, tablet, and desktop wireframes" /></div></div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>06 / Initial Visual Direction</h2></div>
      <div class="project-section__content"><p class="eyebrow">Original project · Nov 2024 – Mar 2025</p>
        <div class="subsection"><h3>Moodboard</h3><p>The original direction was friendly, compassionate, warm, hopeful, and organized.</p><PawsitiveImage file="moodboard.jpg" alt="Original Pawsitive Futures moodboard" /></div>
        <div class="subsection"><h3>Style Tile</h3><PawsitiveImage file="style-tile.jpg" alt="Original colour palette, typography, buttons, and imagery" /></div>
        <div class="subsection"><h3>First Implemented Interface</h3><p>Selected screens from the first coded version establish the original visual direction.</p><div class="compact-grid">{["Home", "Adopt", "Contact"].map(name => <PawsitiveImage file={`initial-${name.toLowerCase()}.jpg`} alt={`Original ${name} screen`} />)}</div></div>
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>07 / Feedback &amp; Reassessment</h2></div>
      <div class="project-section__content"><p class="eyebrow">Original project · 2024–2025</p><p class="project-lead">After the first version was designed and coded, focus-group feedback and my own review highlighted four areas for improvement.</p><div class="compact-grid two-columns">{findings.map(([title, copy], index) => <article class="compact-item"><span class="eyebrow">0{index + 1}</span><h3>{title}</h3><p>{copy}</p></article>)}</div><PawsitiveImage file="feedback-01.jpg" alt="Original interface with feedback annotations" /><PawsitiveImage file="feedback-02.jpg" alt="Additional original screen with feedback annotations" optional /></div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>08 / Exploring a New Visual Direction</h2></div>
      <div class="project-section__content"><p class="eyebrow">2026 Interface Refinement</p><p class="project-lead">I revisited the interface in 2026, using the earlier feedback as a starting point for a broader visual refinement.</p>
        <div class="subsection"><h3>Lovable Explorations</h3><p>AI-assisted visual exploration</p><div class="compact-grid">{["Concept 01", "Concept 02", "Concept 03"].map(name => <PawsitiveImage file={`lovable-${name.toLowerCase().replace(" ", "-")}.jpg`} alt={`${name} — AI-assisted visual exploration`} optional={name === "Concept 03"} />)}</div></div>
        <div class="subsection"><h3>What Carried Forward</h3><p class="editorial-placeholder">Confirmed ideas and their connection to the final interface to be added alongside the selected concepts.</p></div>
        <p class="workflow-note"><strong>AI-assisted workflow:</strong> Lovable was used to explore and compare visual ideas during the refinement. Selected ideas were reviewed, adapted, and implemented within the existing responsive website.</p>
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>09 / Final Responsive Experience</h2></div>
      <div class="project-section__content"><p class="project-lead">The refined experience brings pet discovery, search and filtering, adoption resources, success stories, events, and ways to foster, volunteer, and donate together across devices.</p>
        <div class="subsection"><h3>Desktop</h3><PawsitiveImage file="final-desktop.jpg" alt="Final coded desktop experience" /></div>
        <div class="compact-grid two-columns"><div class="subsection"><h3>Tablet</h3><PawsitiveImage file="final-tablet.jpg" alt="Final coded tablet experience" /></div><div class="subsection"><h3>Mobile</h3><PawsitiveImage file="final-mobile.jpg" alt="Final coded mobile experience" /></div></div>
      </div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>10 / Build &amp; Implementation</h2></div>
      <div class="project-section__content"><p class="project-lead">I translated the experience into a responsive multi-page website using HTML, CSS, and JavaScript, managing the project with Git and GitHub and deploying it through GitHub Pages.</p><div class="compact-grid two-columns"><div class="compact-item"><h3>Stack</h3><p>HTML · CSS · JavaScript</p></div><div class="compact-item"><h3>Workflow</h3><p>Git · GitHub · GitHub Pages</p></div></div><p>The implementation covered mobile, tablet, and desktop layouts, navigation, search and filter interactions, reusable styling, front-end refinement, and deployment.</p></div>
    </section>

    <section class="project-section site-shell">
      <div class="project-section__label"><h2>11 / Outcome</h2></div>
      <div class="project-section__content"><p class="project-lead">Pawsitive Futures resulted in a fully designed and developed responsive website that brings pet discovery, adoption guidance, resources, and community involvement into one experience. Revisiting the interface later also allowed the visual direction to evolve without losing the research-led structure established in the original project.</p>
        {liveSiteUrl ? <a class="prototype-link" href={liveSiteUrl}>View Live Website ↗</a> : <p class="pending-link">View Live Website <span>Link coming soon</span></p>}
        <div class="subsection"><h3>Reflection</h3><p>Building the first version showed how responsive behavior, content density, and visual hierarchy can reveal issues that are less obvious in static mockups.</p></div>
        <ProjectPager currentSlug="pawsitive-futures" />
      </div>
    </section>
  </main>
  <dialog class="paws-board-dialog" aria-label="Enlarged project image">
    <form method="dialog" class="paws-board-dialog__toolbar">
      <button type="button" class="paws-board-dialog__zoom" aria-pressed="false">View actual size</button>
      <button class="paws-board-dialog__close" autofocus>Close ×</button>
    </form>
    <div class="paws-board-dialog__image"></div>
  </dialog>

  <script>
    function setupPawsBoards() {
      const dialog = document.querySelector<HTMLDialogElement>('.paws-board-dialog');
      const imageContainer = dialog?.querySelector<HTMLDivElement>('.paws-board-dialog__image');
      if (!dialog || !imageContainer || dialog.dataset.ready) return;
      dialog.dataset.ready = 'true';
      const zoom = dialog.querySelector<HTMLButtonElement>('.paws-board-dialog__zoom');
      function setZoom(actualSize: boolean) {
        imageContainer!.classList.toggle('is-actual-size', actualSize);
        if (zoom) {
          zoom.textContent = actualSize ? 'Fit to window' : 'View actual size';
          zoom.setAttribute('aria-pressed', String(actualSize));
        }
        imageContainer!.scrollTo(0, 0);
      }
      zoom?.addEventListener('click', () => {
        setZoom(!imageContainer.classList.contains('is-actual-size'));
      });
      let opener: HTMLButtonElement | null = null;
      document.querySelectorAll<HTMLButtonElement>('.paws-board-open').forEach((button) => {
        const thumbnail = button.querySelector('img');
        if (!thumbnail) return;
        button.setAttribute('aria-label', `Enlarge: ${thumbnail.alt}`);
        button.addEventListener('click', () => {
          const enlarged = new Image();
          enlarged.src = thumbnail.currentSrc || thumbnail.src;
          enlarged.alt = thumbnail.alt;
          imageContainer.replaceChildren(enlarged);
          setZoom(false);
          opener = button;
          dialog.showModal();
          document.documentElement.classList.add('paws-board-is-open');
          imageContainer.scrollTo(0, 0);
        });
      });
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
      });
      dialog.addEventListener('close', () => {
        document.documentElement.classList.remove('paws-board-is-open');
        opener?.focus({ preventScroll: true });
      });
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.classList.remove('paws-board-is-open');
      }, { once: true });
    }
    setupPawsBoards();
    document.addEventListener('astro:page-load', setupPawsBoards);
  </script>
  <Footer />
</BaseLayout>
<style>
  .competitor-review { margin-top: 2.5rem; gap: 1rem; align-items: stretch; }
  .competitor-review article { border-top: 1px solid var(--border); padding-top: 1.3rem; }
  .competitor-logo { display: flex; align-items: center; justify-content: center; height: 5rem; margin-bottom: 1.25rem; padding: .75rem; }
  .competitor-logo img { width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain; }
  :global(html[data-theme="dark"]) .competitor-logo { background: #f7f4ef; }
  .competitor-review strong { color: var(--text); font-weight: 500; }

  .interview-map { margin: 1.5rem 0 2rem; }
  .paws-board-open { display: block; width: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; }
  .paws-board-open img { display: block; width: 100%; height: auto; }
  .synthesis-findings article { border-top: 1px solid var(--border); padding-top: 1.5rem; }
  .synthesis-findings h4 { margin-bottom: .75rem; }
  :global(html.paws-board-is-open) { overflow: hidden; }
  .paws-board-dialog { width: 96vw; max-width: 96vw; max-height: 94dvh; margin: auto; padding: 0; border: 1px solid var(--border); background: var(--bg-soft); color: var(--text); }
  .paws-board-dialog::backdrop { background: rgb(0 0 0 / 75%); }
  .paws-board-dialog__toolbar { display: flex; justify-content: flex-end; gap: .75rem; margin: 0; padding: .75rem 1rem; }
  .paws-board-dialog__toolbar button { padding: .5rem .75rem; border: 1px solid var(--border); background: var(--bg); color: var(--text); cursor: pointer; }
  .paws-board-open:focus-visible, .paws-board-dialog__toolbar button:focus-visible { outline: 3px solid var(--text); outline-offset: 4px; }
  .paws-board-dialog__image { max-height: calc(94dvh - 5rem); overflow: auto; }
  .paws-board-dialog__image :global(img) { display: block; width: auto; max-width: 100%; max-height: calc(94dvh - 6rem); height: auto; object-fit: contain; margin-inline: auto; }
  .paws-board-dialog__image.is-actual-size :global(img) { max-width: none; max-height: none; }

  .at-a-glance { margin: 2rem 0 0; color: var(--project-highlight); }
  /* Cambridge blue, deepened for small text on the portfolio cream. */
  .pawsitive { --project-highlight: #3f6e6b; }
  :global(html[data-theme="dark"]) .pawsitive { --project-highlight: #7ca8a5; }
  .pawsitive .project-number,
  .pawsitive .project-label,
  .pawsitive .project-back-link,
  .pawsitive .project-facts dt,
  .pawsitive .prototype-link { color: var(--project-highlight); }
  .pawsitive-hero-image { margin-top: clamp(3rem, 6vw, 5rem); }
  .pawsitive-hero-image :global(figure), .pawsitive-hero-image :global(.image-placeholder) { margin: 0; }
  .project-section__label h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 3rem); line-height: 1; font-weight: 700; letter-spacing: -.05em; }
  .project-section__content { min-width: 0; }
  .project-section__content p { color: var(--text-muted); line-height: 1.75; }
  .project-section__content h3, .project-section__content h4 { font-family: var(--font-body); font-weight: 500; letter-spacing: 0; }
  .project-section__content .subsection > h3 { font-weight: 700; }
  .project-section__content h3 { margin: 0 0 1rem; font-size: 0.95rem; line-height: 1.5; color: var(--text); }
  .project-section__content h4 { margin: 0 0 1rem; font-size: 0.95rem; line-height: 1.5; }
  .subsection + .subsection { margin-top: 3rem; }
  .project-lead + .subsection, .eyebrow + .subsection { margin-top: 2rem; }
  .compact-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin: 1.5rem 0; }
  .two-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .compact-item { padding: 1.5rem; border: 1px solid var(--border); background: var(--bg-soft); color: var(--text); }
  .compact-item h3 { font-size: 0.95rem; }
  .compact-item p:last-child { margin-bottom: 0; }
  .eyebrow, .asset-placeholder > span { font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .project-section__content .eyebrow { color: var(--text); }
  .compact-item > .eyebrow { display: block; margin: 1.5rem 0 .75rem; }
  .compact-item > .eyebrow:first-child { margin-top: 0; }
  .asset-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .75rem; min-height: 13rem; padding: 2rem; margin: 1.5rem 0; text-align: center; border: 1px dashed var(--text-muted); background: var(--bg-soft); color: var(--text); }
  .asset-placeholder p { max-width: 36rem; margin: 0; color: var(--text-muted); }
  .compact-grid > .asset-placeholder { margin: 0; padding: 1.5rem; }
  .hero-placeholder { min-height: 22rem; margin-top: 2.5rem; }
  .hero-placeholder strong { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 4rem); }
  .final-desktop { min-height: 25rem; }
  .final-device { min-height: 25rem; }
  .evidence { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 2rem; padding: 2rem 0; margin: 2rem 0; border-block: 1px solid var(--border); }
  .evidence p { display: flex; flex-direction: column; gap: .75rem; margin: 0; color: var(--text-muted); }
  .evidence strong { font-size: 2.25rem; line-height: 1.2; color: var(--text); }
  .evidence .devices { font-size: clamp(1.15rem, 2vw, 1.75rem); }
  .pending-link { color: var(--text); font-weight: 600; }
  .pending-link span { display: block; margin-top: .5rem; color: var(--text-muted); font-size: .85rem; font-weight: 400; }
  .workflow-note, .editorial-placeholder { border-left: 2px solid var(--text-muted); padding: 1rem 1.5rem; margin-top: 2rem; }
  @media (max-width: 1000px) { .compact-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .compact-grid, .two-columns, .evidence { grid-template-columns: 1fr; } .hero-placeholder, .final-desktop, .final-device { min-height: 16rem; } }
  .project-section__content .competitive-section { border-top: 1px solid var(--border); padding-top: 1.5rem; margin-top: 2.5rem; }
  .project-section__content .competitive-section > h3,
  .project-section__content .competitor-review h4 { font-size: 1rem; font-weight: 600; line-height: 1.45; letter-spacing: 0; margin: 0; }
  .project-section__content .competitive-section p { font-family: var(--font-body); font-size: .95rem; font-weight: 400; line-height: 1.7; margin-top: .8rem; }
