---
import SystemsIcon from "../components/icons/SystemsIcon.astro";
import ClarityIcon from "../components/icons/ClarityIcon.astro";
import StoryIcon from "../components/icons/StoryIcon.astro";
import RefineIcon from "../components/icons/RefineIcon.astro";


import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="About - Esther Odeyemi"
  description="About Esther Odeyemi, a digital experience designer working across UI/UX, web, brand systems, and visual storytelling."
>
  <Header />

  <main class="project-detail about-page">
    <section class="about-page__hero site-shell section">
      <a href="/" class="project-back-link">← Home</a>

      <p class="project-label">Profile / Background / Practice</p>

      <h1>About Esther</h1>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Profile</p>
      </div>

      <div class="about-page__content">
        <p class="about-page__lead">
          I design digital experiences that make information easier to find,
          understand, and use.
        </p>

        <p>
          My work spans UI/UX design, responsive websites, brand systems, and
          visual storytelling. I enjoy shaping user flows, mobile screens,
          website layouts, prototypes, and visual systems with clarity at the
          center.
        </p>

        <p>
          My background in Information and Communication Engineering shapes how I
          approach design. It helps me think in systems, break down complex
          problems, and turn messy information into clear digital experiences.
        </p>

        <p>
          Alongside selected portfolio projects, I’m currently developing new
          work across digital product design, branding, and visual storytelling.
          Some projects are still in progress, so this page will continue to
          grow as the work becomes ready to share.
        </p>
      </div>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Expertise</p>
      </div>

      <div class="about-page__content">
        <div class="about-page__grid">
          <article>
            <h2>UI/UX Design</h2>
            <p>
              User flows, wireframes, prototypes, usability testing, mobile
              screens, product interfaces, and responsive digital experiences.
            </p>
          </article>

          <article>
            <h2>Web Design</h2>
            <p>
              Website layouts, responsive structure, clear content hierarchy, and
              front-end implementation using HTML, CSS, JavaScript, and React.
            </p>
          </article>

          <article>
            <h2>Brand Systems</h2>
            <p>
              Visual identity, typography, color systems, campaign assets,
              packaging direction, and consistent brand layouts.
            </p>
          </article>

          <article>
            <h2>Visual Storytelling</h2>
            <p>
              Fashion and lifestyle illustration, campaign visuals, art
              direction, and storytelling-focused design work.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Education</p>
      </div>

      <div class="about-page__content">
        <div class="about-page__timeline">
          <article>
            <span>Algonquin College</span>
            <h2>Interactive Media Design</h2>
            <p>
              Honours diploma focused on digital design, web, media, and
              interactive experiences.
            </p>
          </article>

          <article>
            <span>Covenant University</span>
            <h2>Information and Communication Engineering</h2>
            <p>
              Engineering background that supports systems thinking,
              problem-solving, and structured design decisions.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Tools</p>
      </div>

      <div class="about-page__content">
        <ul class="about-page__pill-list">
          <li>Figma</li>
          <li>FigJam</li>
          <li>Maze</li>
          <li>Adobe XD</li>
          <li>Framer</li>
          <li>Photoshop</li>
          <li>Illustrator</li>
          <li>InDesign</li>
          <li>After Effects</li>
          <li>HTML</li>
          <li>CSS</li>
          <li>JavaScript</li>
          <li>React</li>
          <li>WordPress</li>
          <li>Shopify</li>
          <li>Drupal</li>
          <li>Wix</li>
          <li>Procreate</li>
        </ul>
      </div>
    </section>

    <section class="about-page__section site-shell">
  <div class="about-page__label">
    <p>Design Mindset</p>
  </div>

  <div class="about-page__content">
    <div class="about-page__grid about-page__grid--icons">
      <article>
        <SystemsIcon />

        <h2>Systems</h2>
        <p>
          My engineering background helps me break complex problems into clearer
          parts and design with structure.
        </p>
      </article>

      <article>
        <ClarityIcon />

        <h2>Clarity</h2>
        <p>
          I focus on clean layouts, clear paths, and easy-to-scan screens so
          people can find what they need faster.
        </p>
      </article>

      <article>
        <StoryIcon />

        <h2>Story</h2>
        <p>
          My visual storytelling background helps me use type, color, imagery,
          and layout to make each project feel more memorable.
        </p>
      </article>

      <article>
        <RefineIcon />

        <h2>Refine</h2>
        <p>
          I like testing ideas, listening to feedback, and polishing the details
          until the experience feels useful and intentional.
        </p>
      </article>
    </div>
  </div>
</section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Highlights</p>
      </div>

      <div class="about-page__content">
        <ul class="about-page__skill-list">
          <li>Dean’s Honours List</li>
          <li>Student Leadership Program Certificate</li>
          <li>Class Representative</li>
          <li>Client-Based Project Lead</li>
          <li>Collaborative Design Projects</li>
          <li>Usability Testing</li>
          <li>Brand Campaign Assets</li>
          <li>Front-End Implementation</li>
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>