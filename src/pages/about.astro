---
import SystemsIcon from "../components/icons/SystemsIcon.astro";
import ClarityIcon from "../components/icons/ClarityIcon.astro";
import StoryIcon from "../components/icons/StoryIcon.astro";
import RefineIcon from "../components/icons/RefineIcon.astro";


import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="About - Esther Odeyemi"
  description="About Esther Odeyemi, a digital experience designer working across UI/UX, web, brand systems, and visual storytelling."
>
  <Header />

  <main class="project-detail about-page">
    <section class="about-page__hero site-shell section">
      <a href="/" class="project-back-link">← Home</a>

      <p class="project-label">Profile / Background / Practice</p>

      <h1>About Esther</h1>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Profile</p>
      </div>

      <div class="about-page__content">
        <p class="about-page__lead">
          I bring ideas to life through thoughtful design, combining creativity, clarity, and an understanding of the people I'm designing for.
        </p>

        <p>
          I'm a curious, visually driven designer who enjoys learning, exploring new ideas, and finding better ways to do things. Outside of design, I enjoy photography, fashion sketching, reading, and working out.
        </p>

        <p>
          I also have a background in Information and Communication Engineering, so I naturally think about how things work and connect, not just how they look.
        </p>
      </div>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Expertise</p>
      </div>

      <div class="about-page__content">
        <div class="about-page__grid">
          <article>
            <h2>Product & UI/UX Design</h2>
            <p>
              User flows, wireframes, prototypes, usability testing, mobile
              interfaces, product interfaces, and responsive digital experiences.
            </p>
          </article>

          <article>
            <h2>Web Design</h2>
            <p>
              Website layouts, responsive structure, clear content hierarchy, and
              front-end implementation using HTML, CSS, JavaScript, and React.
            </p>
          </article>

          <article>
            <h2>Brand Identity</h2>
            <p>
              Logo design, typography, colour palettes, brand guidelines, and cohesive visual identities across digital and print materials.
            </p>
          </article>

          <article>
            <h2>Graphic & Visual Design</h2>
            <p>
              Editorial layouts, presentation design, promotional graphics, campaign visuals, digital illustration, and visual storytelling.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Education</p>
      </div>

      <div class="about-page__content">
        <div class="about-page__timeline">
          <article>
            <span>Algonquin College</span>
            <h2>Interactive Media Design</h2>
            <p>
              Diploma with Honours focused on digital design, web, media, and interactive experiences.
            </p>
          </article>

          <article>
            <span>Covenant University</span>
            <h2>Information and Communication Engineering</h2>
            <p>
              Built a foundation in technical problem-solving, analytical thinking, and understanding complex systems.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Tools</p>
      </div>

      <div class="about-page__content">
        <ul class="about-page__pill-list">
          <li>Figma</li>
          <li>FigJam</li>
          <li>Maze</li>
          <li>Adobe Premiere Pro</li>
          <li>Framer</li>
          <li>Photoshop</li>
          <li>Illustrator</li>
          <li>InDesign</li>
          <li>After Effects</li>
          <li>HTML</li>
          <li>CSS</li>
          <li>JavaScript</li>
          <li>React</li>
          <li>WordPress</li>
          <li>Shopify</li>
          <li>Drupal</li>
          <li>Wix</li>
          <li>Procreate</li>
        </ul>
      </div>
    </section>

    <section class="about-page__section site-shell">
  <div class="about-page__label">
    <p>Design Mindset</p>
  </div>

  <div class="about-page__content">
    <div class="about-page__grid about-page__grid--icons">
      <article>
        <SystemsIcon />

        <h2>Curious</h2>
        <p>
          I explore the context, ask questions, and notice the details before I
          settle on a direction.
        </p>
      </article>

      <article>
        <ClarityIcon />

        <h2>Intentional</h2>
        <p>
          Every choice, from hierarchy to interaction to visual tone, should have a
          clear purpose.
        </p>
      </article>

      <article>
        <StoryIcon />

        <h2>Warm</h2>
        <p>
          I want the things I design to feel approachable, easy to understand, and connected to the people they're made for.
        </p>
      </article>

      <article>
        <RefineIcon />

        <h2>Practical</h2>
        <p>
          A strong idea still needs to work. I balance visual expression with
          clarity, feedback, and real-world use.
        </p>
      </article>
    </div>
  </div>
</section>

  </main>

  <Footer />
</BaseLayout>
