---
import SystemsIcon from "../components/icons/SystemsIcon.astro";
import ClarityIcon from "../components/icons/ClarityIcon.astro";
import StoryIcon from "../components/icons/StoryIcon.astro";
import RefineIcon from "../components/icons/RefineIcon.astro";


import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="About - Esther Odeyemi"
  description="About Esther Odeyemi, a digital experience designer working across UI/UX, web, brand systems, and visual storytelling."
>
  <Header />

  <main class="project-detail about-page">
    <section class="about-page__hero site-shell section">
      <a href="/" class="project-back-link">← Home</a>

      <p class="project-label">Profile / Background / Practice</p>

      <h1>About Esther</h1>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Profile</p>
      </div>

      <div class="about-page__content">
        <p class="about-page__lead">
          I design digital experiences with curiosity, clarity, and care for the people using them.
        </p>

        <p>
          I’m a visually driven designer who notices the small things. Outside of design, I take photos, sketch fashion ideas, read, and work out. Those interests keep me curious about people, details, and how things come together.
        </p>

        <p>
          My work spans <strong>product design, UI/UX, and brand identity</strong>, from user flows and prototypes to responsive interfaces and visual systems. I like making complicated things feel simple, useful, and easy to understand.
        </p>

        <p>
          I also have a background in Information and Communication Engineering, so I naturally think about how things work and connect, not just how they look.
        </p>
      </div>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Expertise</p>
      </div>

      <div class="about-page__content">
        <div class="about-page__grid">
          <article>
            <h2>UI/UX Design</h2>
            <p>
              User flows, wireframes, prototypes, usability testing, mobile
              screens, product interfaces, and responsive digital experiences.
            </p>
          </article>

          <article>
            <h2>Web Design</h2>
            <p>
              Website layouts, responsive structure, clear content hierarchy, and
              front-end implementation using HTML, CSS, JavaScript, and React.
            </p>
          </article>

          <article>
            <h2>Brand Identity</h2>
            <p>
              Logo design, typography, colour palettes, campaign assets, and packaging that give a brand a clear and consistent identity.
            </p>
          </article>

          <article>
            <h2>Visual Storytelling</h2>
            <p>
              Fashion and lifestyle illustration, campaign visuals, art
              direction, and storytelling-focused design work.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Education</p>
      </div>

      <div class="about-page__content">
        <div class="about-page__timeline">
          <article>
            <span>Algonquin College</span>
            <h2>Interactive Media Design</h2>
            <p>
              Honours diploma focused on digital design, web, media, and
              interactive experiences.
            </p>
          </article>

          <article>
            <span>Covenant University</span>
            <h2>Information and Communication Engineering</h2>
            <p>
              Engineering background that supports systems thinking,
              problem-solving, and structured design decisions.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Tools</p>
      </div>

      <div class="about-page__content">
        <ul class="about-page__pill-list">
          <li>Figma</li>
          <li>FigJam</li>
          <li>Maze</li>
          <li>Adobe XD</li>
          <li>Framer</li>
          <li>Photoshop</li>
          <li>Illustrator</li>
          <li>InDesign</li>
          <li>After Effects</li>
          <li>HTML</li>
          <li>CSS</li>
          <li>JavaScript</li>
          <li>React</li>
          <li>WordPress</li>
          <li>Shopify</li>
          <li>Drupal</li>
          <li>Wix</li>
          <li>Procreate</li>
        </ul>
      </div>
    </section>

    <section class="about-page__section site-shell">
  <div class="about-page__label">
    <p>Design Mindset</p>
  </div>

  <div class="about-page__content">
    <div class="about-page__grid about-page__grid--icons">
      <article>
        <SystemsIcon />

        <h2>Curious</h2>
        <p>
          I explore the context, ask questions, and notice the details before I
          settle on a direction.
        </p>
      </article>

      <article>
        <ClarityIcon />

        <h2>Intentional</h2>
        <p>
          Every choice, from hierarchy to interaction to visual tone, should have a
          clear purpose.
        </p>
      </article>

      <article>
        <StoryIcon />

        <h2>Warm</h2>
        <p>
          I want digital experiences to feel welcoming, understandable, and made
          for people rather than just systems.
        </p>
      </article>

      <article>
        <RefineIcon />

        <h2>Practical</h2>
        <p>
          A strong idea still needs to work. I balance visual expression with
          clarity, feedback, and real world use.
        </p>
      </article>
    </div>
  </div>
</section>

    <section class="about-page__section site-shell">
      <div class="about-page__label">
        <p>Highlights</p>
      </div>

      <div class="about-page__content">
        <ul class="about-page__skill-list">
          <li>Client-Based Project Lead</li>
          <li>Collaborative Design Projects</li>
          <li>Usability Testing</li>
          <li>Brand Campaign Assets</li>
          <li>Front-End Implementation</li>
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
